---
import { COMPANY, PRIMARY_NAV } from '@/data/navigation';

const year = new Date().getFullYear();
---

<footer>
  <div class="f-grid">
    <section aria-labelledby="footer-brand" class="fbrand-wrap">
      <h2 id="footer-brand" class="fbrand">
        <img src="/logo.webp" alt="Logotipo Ingeniería Vial TEPATE" width="40" height="40" class="fbrand-logo" />
        <span>{COMPANY.shortName}</span>
      </h2>
      <p class="ftag">
        {COMPANY.tagline}. Fabricación e instalación de equipos y señalamiento vial con cumplimiento normativo SCT.
      </p>
      <span class="fnorm">SCT N-CMT-5-001-13</span>
      <span class="fnorm" style="margin-left: 8px;">ASTM</span>
      <div class="fsocial" aria-label="Redes sociales">
        <a href="https://wa.me/528118959042" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.118 1.522 5.848L0 24l6.335-1.502A11.954 11.954 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.002-1.366l-.36-.213-3.761.892.952-3.653-.234-.374A9.818 9.818 0 1112 21.818z"/>
          </svg>
        </a>
        <a href="https://www.facebook.com/profile.php?id=100063746240114" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
      </div>
    </section>

    <nav aria-labelledby="footer-nav">
      <h2 id="footer-nav" class="fct">Navegación</h2>
      <ul class="flinks">
        {
          PRIMARY_NAV.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li>
          <a href="/aviso-privacidad">Aviso de Privacidad</a>
        </li>
      </ul>
    </nav>

    <section aria-labelledby="footer-products">
      <h2 id="footer-products" class="fct">Productos</h2>
      <ul class="flinks">
        <li><a href="/productos?cat=calderas">Calderas Termoplásticas</a></li>
        <li><a href="/productos?cat=maquinas">Máquinas Aplicadoras</a></li>
        <li><a href="/productos?cat=senalamiento">Señalamiento</a></li>
        <li><a href="/productos?cat=confinamiento">Confinamiento</a></li>
      </ul>
    </section>

    <section aria-labelledby="footer-contact">
      <h2 id="footer-contact" class="fct">Contacto</h2>
      <ul class="flinks">
        <li>
          <a href={`tel:${COMPANY.phones[0]}`}>Tel. {COMPANY.phoneDisplay}</a>
        </li>
        <li>
          <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
        </li>
        <li><span class="text-mist">L–V {COMPANY.hours.weekdays}</span></li>
        <li><span class="text-mist">Sáb {COMPANY.hours.saturday}</span></li>
        <li class="mt-2">
          <address class="not-italic text-mist text-xs leading-relaxed normal-case tracking-normal">
            {COMPANY.address.streetAddress}<br />
            {COMPANY.address.addressLocality}, {COMPANY.address.addressRegion}
          </address>
        </li>
      </ul>
    </section>
  </div>

  <div class="fbot">
    <small class="fcp">
      © {year} {COMPANY.legalName}. Todos los derechos reservados.
    </small>
    <div class="fnoms">
      <span class="fnom">SCT</span>
      <span class="fnom">ASTM</span>
      <span class="fnom">ISO 9001</span>
    </div>
  </div>
</footer>
