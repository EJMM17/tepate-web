---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  currentPath?: string;
  navItems?: readonly NavItem[];
  logoSrc?: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const DEFAULT_NAV: readonly NavItem[] = [
  { label: 'Inicio', href: '/' },
  { label: 'Productos', href: '/productos' },
  { label: 'Servicios', href: '/servicios' },
  { label: 'Proyectos', href: '/proyectos' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Contacto', href: '/contacto' },
];

const {
  currentPath = '/',
  navItems = DEFAULT_NAV,
  logoSrc = '/logo.webp',
  ctaHref = '/contacto',
  ctaLabel = 'Cotizar',
} = Astro.props;

const isActive = (href: string): boolean =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header
  class="fixed top-0 inset-x-0 w-full z-50 backdrop-blur-md bg-black/80 border-b border-gray-800"
  role="banner"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-6">
    <a
      href="/"
      class="flex items-center gap-3 shrink-0"
      aria-label="Ingeniería Vial TEPATE — Inicio"
    >
      <img
        src={logoSrc}
        alt="TEPATE"
        width="56"
        height="56"
        class="h-12 w-auto scale-110 drop-shadow-[0_0_12px_rgba(225,255,0,0.25)]"
        decoding="async"
        loading="eager"
      />
      <span class="hidden sm:inline-block text-gray-100 font-black tracking-wider text-lg">
        TEPATE
      </span>
    </a>

    <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-8">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'text-sm font-semibold tracking-wide uppercase transition-colors',
              isActive(item.href)
                ? 'text-neon'
                : 'text-gray-100 hover:text-neon',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={ctaHref}
        class="hidden sm:inline-flex items-center gap-2 bg-neon text-gray-900 font-bold px-5 py-2.5 rounded-md hover:bg-neonDim transition-colors"
      >
        {ctaLabel}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>

      <button
        type="button"
        id="tp-mobile-toggle"
        class="lg:hidden inline-flex items-center justify-center w-11 h-11 text-gray-100 hover:text-neon"
        aria-label="Abrir menú"
        aria-controls="tp-mobile-menu"
        aria-expanded="false"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="tp-mobile-menu"
    class="lg:hidden hidden border-t border-gray-800 bg-black/95 backdrop-blur-md"
  >
    <nav aria-label="Navegación móvil" class="px-4 py-4 flex flex-col gap-1">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'px-3 py-3 rounded-md text-base font-semibold uppercase tracking-wide',
              isActive(item.href)
                ? 'text-neon bg-white/5'
                : 'text-gray-100 hover:text-neon hover:bg-white/5',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={ctaHref}
        class="mt-2 inline-flex justify-center items-center bg-neon text-gray-900 font-bold px-5 py-3 rounded-md"
      >
        {ctaLabel}
      </a>
    </nav>
  </div>
</header>

<div aria-hidden="true" class="h-20"></div>

<script>
  const toggle = document.getElementById('tp-mobile-toggle');
  const menu = document.getElementById('tp-mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    });
  }
</script>
