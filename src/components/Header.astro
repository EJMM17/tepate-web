---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  currentPath?: string;
  navItems?: readonly NavItem[];
  logoSrc?: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const DEFAULT_NAV: readonly NavItem[] = [
  { label: 'Inicio', href: '/' },
  { label: 'Productos', href: '/productos' },
  { label: 'Servicios', href: '/servicios' },
  { label: 'Proyectos', href: '/proyectos' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Contacto', href: '/contacto' },
];

const {
  currentPath = '/',
  navItems = DEFAULT_NAV,
  logoSrc = '/logo.webp',
  ctaHref = '/contacto',
  ctaLabel = 'Cotizar',
} = Astro.props;

const isActive = (href: string): boolean =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header
  class="fixed top-0 inset-x-0 z-50 bg-black/85 backdrop-blur-md border-b border-steel"
  role="banner"
>
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-10 h-16 sm:h-20 flex items-center justify-between gap-6">
    <a
      href="/"
      class="flex items-center shrink-0"
      aria-label="Ingeniería Vial TEPATE — Inicio"
    >
      <img
        src={logoSrc}
        alt="Ingeniería Vial TEPATE"
        width="120"
        height="44"
        class="h-9 sm:h-11 w-auto object-contain"
        decoding="async"
        loading="eager"
      />
    </a>

    <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-9">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'relative text-[13px] font-bold uppercase tracking-[0.12em] transition-colors duration-300 py-1',
              'after:absolute after:left-0 after:-bottom-0.5 after:h-px after:bg-neon after:transition-all after:duration-300',
              isActive(item.href)
                ? 'text-neon after:w-full'
                : 'text-bone hover:text-neon after:w-0 hover:after:w-full',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={ctaHref}
        class="hidden sm:inline-flex items-center gap-2 bg-neon text-black font-extrabold text-xs tracking-[0.14em] uppercase px-6 py-3 border-2 border-neon hover:bg-transparent hover:text-neon transition-colors duration-300"
      >
        {ctaLabel}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>

      <button
        type="button"
        id="tp-mobile-toggle"
        class="lg:hidden inline-flex items-center justify-center w-11 h-11 border border-steel text-bone hover:text-neon hover:border-neon transition-colors"
        aria-label="Abrir menú"
        aria-controls="tp-mobile-menu"
        aria-expanded="false"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="tp-mobile-menu"
    class="lg:hidden hidden border-t border-steel bg-black/95 backdrop-blur-md"
  >
    <nav aria-label="Navegación móvil" class="px-4 py-4 flex flex-col gap-1">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'px-3 py-3 text-sm font-bold uppercase tracking-[0.12em] transition-colors',
              isActive(item.href)
                ? 'text-neon bg-white/5'
                : 'text-bone hover:text-neon hover:bg-white/5',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={ctaHref}
        class="mt-3 inline-flex justify-center items-center bg-neon text-black font-extrabold text-sm tracking-[0.14em] uppercase px-5 py-3.5 border-2 border-neon"
      >
        {ctaLabel}
      </a>
    </nav>
  </div>
</header>

<div aria-hidden="true" class="h-16 sm:h-20"></div>

<script>
  const toggle = document.getElementById('tp-mobile-toggle');
  const menu = document.getElementById('tp-mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    });
  }
</script>
