---
import { PRIMARY_NAV, CATALOG_PDF, TOPBAR_ITEMS } from '@/data/navigation';
import MobileNav from '@/components/MobileNav.tsx';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const isActive = (href: string): boolean =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<div
  class="topbar"
  role="region"
  aria-label="Información de la empresa"
>
  {
    TOPBAR_ITEMS.map((item, idx) => (
      <>
        {idx === 0 && (
          <span class="dot" aria-hidden="true" />
        )}
        <span>{item}</span>
        {idx < TOPBAR_ITEMS.length - 1 && (
          <span class="sep" aria-hidden="true">·</span>
        )}
      </>
    ))
  }
</div>

<header class="sticky top-0 z-40" style="backdrop-filter: blur(20px) saturate(1.2); background: rgba(0,0,0,0.85); border-bottom: 1px solid #262626;">
  <nav
    aria-label="Principal"
    class="max-w-screen-2xl mx-auto flex items-center justify-between px-6 md:px-12 h-[72px]"
  >
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label="Inicio — Ingeniería Vial TEPATE">
      <img
        src="/logo.webp"
        alt="Logotipo Ingeniería Vial TEPATE"
        width="40"
        height="40"
        fetchpriority="high"
        decoding="async"
        class="h-10 w-10"
      />
      <span class="hidden sm:block font-display font-black text-white text-lg tracking-wide uppercase">
        TEPATE
      </span>
    </a>

    <ul class="hidden md:flex items-center gap-10 font-mono text-xs uppercase tracking-widest">
      {
        PRIMARY_NAV.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'transition-colors duration-300 ease-brand hover:text-neon focus-visible:text-neon relative py-1',
                isActive(link.href) ? 'text-neon' : 'text-mist',
              ]}
            >
              {link.label}
              {isActive(link.href) && (
                <span class="absolute bottom-0 left-0 w-full h-[1px] bg-neon" />
              )}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={CATALOG_PDF.href}
          download
          aria-label={CATALOG_PDF.ariaLabel}
          class="inline-flex items-center gap-2 bg-neon text-black hover:bg-transparent hover:text-neon border-2 border-neon transition-all duration-300 ease-brand px-5 py-3 font-bold text-[11px] tracking-widest"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          {CATALOG_PDF.label}
        </a>
      </li>
    </ul>

    <button
      type="button"
      id="ham-btn"
      class="md:hidden flex flex-col justify-center items-center gap-[6px] w-12 h-12 -mr-2 border border-steel hover:border-neon transition-colors"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <span class="block w-6 h-[2px] bg-bone transition-colors" aria-hidden="true"></span>
      <span class="block w-6 h-[2px] bg-bone transition-colors" aria-hidden="true"></span>
      <span class="block w-6 h-[2px] bg-bone transition-colors" aria-hidden="true"></span>
    </button>
  </nav>

  <MobileNav navItems={PRIMARY_NAV} catalogPdf={CATALOG_PDF} client:idle />
</header>
