---
interface Props {
  title: string;
  model: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
  href: string;
  capacity?: string;
  category?: string;
}

const {
  title,
  model,
  description,
  imageSrc,
  imageAlt,
  href,
  capacity,
  category,
} = Astro.props;
---

<a
  href={href}
  class="group flex flex-col bg-[#1A1A1A] border border-gray-800 rounded-xl overflow-hidden transition-all duration-300 hover:border-neon/60 hover:shadow-xl hover:shadow-neon/10 focus-visible:outline-2 focus-visible:outline-neon"
  aria-label={`${title} — ver ficha`}
>
  <div class="relative overflow-hidden aspect-square bg-black">
    <img
      src={imageSrc}
      alt={imageAlt}
      class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
      decoding="async"
    />
    {
      category && (
        <span class="absolute top-3 left-3 inline-flex items-center text-[10px] font-bold uppercase tracking-widest bg-black/70 text-neon border border-neon/40 px-2.5 py-1 rounded">
          {category}
        </span>
      )
    }
  </div>

  <div class="flex flex-col gap-2 p-5">
    <span class="text-xs font-mono uppercase tracking-widest text-neon">
      {model}
    </span>
    <h3 class="text-xl font-bold text-white leading-tight">{title}</h3>
    <p class="text-sm text-gray-300 leading-relaxed line-clamp-3">{description}</p>

    {
      capacity && (
        <div class="mt-3 pt-3 border-t border-gray-800 flex items-center justify-between">
          <span class="text-xs text-gray-300 uppercase tracking-wide">Capacidad</span>
          <span class="text-sm font-bold text-gray-100">{capacity}</span>
        </div>
      )
    }

    <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-neon group-hover:gap-3 transition-all">
      Ver ficha técnica
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </span>
  </div>
</a>
