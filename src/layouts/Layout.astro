---
import type { SEOMeta } from '@/types';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';
import { buildWhatsAppUrl } from '@/lib/whatsapp';

interface Props extends SEOMeta {
  currentPath?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType = 'website',
  locale = 'es_MX',
  jsonLd,
  currentPath = Astro.url.pathname,
  bodyClass = '',
} = Astro.props;

const FONTS_HREF =
  'https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;700;900&family=Barlow:wght@400;600;900&family=IBM+Plex+Mono:wght@400;600;700&display=swap';

const whatsappUrl = buildWhatsAppUrl();
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#E1FF00" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={FONTS_HREF} />
    <link rel="stylesheet" media="print" href={FONTS_HREF} onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={FONTS_HREF} /></noscript>

    {
      jsonLd && (
        Array.isArray(jsonLd)
          ? jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} is:inline />)
          : <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
      )
    }
    <slot name="head" />
  </head>
  <body
    class:list={[
      'bg-black text-bone font-sans antialiased min-h-screen flex flex-col',
      bodyClass,
    ]}
  >
    <!-- Preloader -->
    <div id="preloader">
      <img src="/logo.webp" alt="" class="preloader-logo-img" width="64" height="64" aria-hidden="true" />
      <div class="preloader-track">
        <div class="preloader-progress"></div>
      </div>
    </div>

    <a
      href="#main-content"
      class="skip-link"
    >
      Saltar al contenido principal
    </a>

    <slot name="header"><Header currentPath={currentPath} /></slot>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <slot name="footer"><Footer /></slot>

    <a href={whatsappUrl} class="wa magnetic" title="WhatsApp" aria-label="Contactar por WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M11.997 2C6.477 2 2 6.477 2 12c0 1.89.524 3.66 1.438 5.168L2 22l4.978-1.304A9.956 9.956 0 0 0 12 22c5.523 0 10-4.477 10-10S17.52 2 11.997 2zm0 18.067a8.06 8.06 0 0 1-4.109-1.133l-.295-.176-3.059.801.818-2.98-.192-.307A8.03 8.03 0 0 1 3.992 12c0-4.418 3.591-8.007 8.005-8.007 4.414 0 8.005 3.589 8.005 8.007 0 4.418-3.591 8.007-8.005 8.007z"/></svg>
    </a>

    <button id="back-to-top" class="back-to-top magnetic" aria-label="Volver arriba">↑</button>

    <script>
      const btn = document.getElementById('back-to-top');
      if (btn) {
        window.addEventListener('scroll', () => btn.classList.toggle('visible', window.scrollY > 300));
        btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      }

      // Keep floating buttons above sticky CTA bar when it's visible
      const stickyCta = document.querySelector('.sticky-cta') as HTMLElement | null;
      if (stickyCta) {
        const updateOffset = () => {
          const h = stickyCta.classList.contains('visible') ? stickyCta.offsetHeight : 0;
          document.documentElement.style.setProperty('--sticky-cta-h', `${h}px`);
        };
        new MutationObserver(updateOffset).observe(stickyCta, { attributes: true, attributeFilter: ['class'] });
        updateOffset();
      }
    </script>

    <script>
      import { initAnimations } from '@/scripts/animations';
      import { initAnalytics } from '@/scripts/analytics';
      initAnalytics();
      initAnimations();
    </script>
  </body>
</html>
