---

<Layout {...seo}>
  <section class="page-header">
    <div class="ph-inner reveal-up">
      <div class="ph-crumb"><a href="/">Inicio</a><span>/</span>Proyectos</div>
      <h1 class="ph-title">PORTAFOLIO <span class="acc">DE OBRA</span></h1>
      <p class="ph-lead">
        Más de 500 proyectos ejecutados exitosamente. Carreteras federales, aeropuertos, parques
        industriales, vialidades urbanas y obras municipales en todo el noreste de México.
      </p>
    </div>
  </section>

  <section class="pcat">
    <div class="pcat-head reveal-up">
      <div>
        <div class="pcat-num">Proyectos destacados</div>
        <h2 class="pcat-h2">OBRA<br />REALIZADA</h2>
      </div>
      <p class="pcat-desc">
        Una selección de los proyectos más representativos por tipo de obra y cliente. Cada
        proyecto incluye fabricación, instalación y seguimiento postventa.
      </p>
    </div>

    <div class="filter-bar reveal-up" role="group" aria-label="Filtrar proyectos por categoría">
      <button class="filter-btn active" data-filter="all" aria-pressed="true">Todos</button>
      <button class="filter-btn" data-filter="carretero" aria-pressed="false">Carretero</button>
      <button class="filter-btn" data-filter="industrial" aria-pressed="false">Industrial</button>
      <button class="filter-btn" data-filter="municipal" aria-pressed="false">Municipal</button>
      <button class="filter-btn" data-filter="aeroportuario" aria-pressed="false">Aeroportuario</button>
    </div>

    <div class="proj-grid reveal-stagger" id="projects-container">
      {projects.map((project, i) => (
        <button
          type="button"
          class="proj"
          data-category={project.category}
          data-index={i}
          data-img={project.img}
          data-alt={project.alt}
          data-title={project.title}
          data-loc={project.loc}
          data-tag={project.tag}
          aria-label={`Ver ${project.title} en pantalla completa`}
        >
          <div class="proj-img">
            <img
              src={project.img}
              alt={project.alt}
              loading={i < 3 ? 'eager' : 'lazy'}
              width="600"
              height="400"
            />
          </div>
          <div class="proj-body">
            <div class="proj-tag">{project.tag}</div>
            <div class="proj-title">{project.title}</div>
            <div class="proj-loc">{project.loc}</div>
          </div>
        </button>
      ))}
    </div>
  </section>

  <dialog class="lightbox" id="lightbox" aria-label="Vista ampliada del proyecto">
    <button type="button" class="lb-close" aria-label="Cerrar" data-lb-close>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
      </svg>
    </button>
    <button type="button" class="lb-nav lb-prev" aria-label="Proyecto anterior" data-lb-prev>
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <button type="button" class="lb-nav lb-next" aria-label="Proyecto siguiente" data-lb-next>
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <figure class="lb-figure">
      <img class="lb-img" id="lb-img" src="" alt="" />
      <figcaption class="lb-meta">
        <div class="lb-tag" id="lb-tag"></div>
        <div class="lb-title" id="lb-title"></div>
        <div class="lb-loc" id="lb-loc"></div>
        <div class="lb-counter" id="lb-counter"></div>
      </figcaption>
    </figure>
  </dialog>
</Layout>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = Array.from(document.querySelectorAll<HTMLButtonElement>('.proj'));

  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      btns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      const filter = btn.dataset.filter ?? 'all';
      cards.forEach((card) => {
        const match = filter === 'all' || card.dataset.category === filter;
        card.classList.toggle('hidden', !match);
        if (match) {
          card.classList.remove('fade-in');
          void card.offsetWidth;
          card.classList.add('fade-in');
        }
      });
    });
  });

  // Lightbox
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement | null;
  const lbTag = document.getElementById('lb-tag');
  const lbTitle = document.getElementById('lb-title');
  const lbLoc = document.getElementById('lb-loc');
  const lbCounter = document.getElementById('lb-counter');

  let visibleCards: HTMLButtonElement[] = [];
  let currentIndex = 0;

  const getVisibleCards = () => cards.filter((c) => !c.classList.contains('hidden'));

  const render = () => {
    if (!dialog || !lbImg || visibleCards.length === 0) return;
    const card = visibleCards[currentIndex];
    if (!card) return;
    lbImg.src = card.dataset.img ?? '';
    lbImg.alt = card.dataset.alt ?? '';
    if (lbTag) lbTag.textContent = card.dataset.tag ?? '';
    if (lbTitle) lbTitle.textContent = card.dataset.title ?? '';
    if (lbLoc) lbLoc.textContent = card.dataset.loc ?? '';
    if (lbCounter) lbCounter.textContent = `${currentIndex + 1} / ${visibleCards.length}`;
    // Preload neighbours
    [1, -1].forEach((offset) => {
      const next = visibleCards[(currentIndex + offset + visibleCards.length) % visibleCards.length];
      if (next?.dataset.img) {
        const img = new Image();
        img.src = next.dataset.img;
      }
    });
  };

  const open = (card: HTMLButtonElement) => {
    if (!dialog) return;
    visibleCards = getVisibleCards();
    const idx = visibleCards.indexOf(card);
    currentIndex = idx >= 0 ? idx : 0;
    render();
    dialog.showModal();
  };

  const close = () => dialog?.close();

  const move = (delta: number) => {
    if (visibleCards.length === 0) return;
    currentIndex = (currentIndex + delta + visibleCards.length) % visibleCards.length;
    render();
  };

  cards.forEach((card) => {
    card.addEventListener('click', () => open(card));
  });

  dialog?.querySelector('[data-lb-close]')?.addEventListener('click', close);
  dialog?.querySelector('[data-lb-prev]')?.addEventListener('click', () => move(-1));
  dialog?.querySelector('[data-lb-next]')?.addEventListener('click', () => move(1));

  // Close when clicking backdrop
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });

  document.addEventListener('keydown', (e) => {
    if (!dialog?.open) return;
    if (e.key === 'ArrowRight') move(1);
    else if (e.key === 'ArrowLeft') move(-1);
  });

  // Touch swipe
  let touchStartX = 0;
  let touchStartY = 0;
  dialog?.addEventListener('pointerdown', (e) => {
    touchStartX = e.clientX;
    touchStartY = e.clientY;
  });
  dialog?.addEventListener('pointerup', (e) => {
    const dx = e.clientX - touchStartX;
    const dy = e.clientY - touchStartY;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
      move(dx < 0 ? 1 : -1);
    }
  });
</script>
