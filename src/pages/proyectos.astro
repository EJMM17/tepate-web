---

<Layout {...seo}>
  <section class="page-header">
    <div class="ph-inner">
      <div class="ph-crumb"><a href="/">Inicio</a><span>/</span>Proyectos</div>
      <h1 class="ph-title">PORTAFOLIO <span class="acc">DE OBRA</span></h1>
      <p class="ph-lead">
        Más de 500 proyectos ejecutados exitosamente. Carreteras federales, aeropuertos, parques
        industriales, vialidades urbanas y obras municipales en todo el noreste de México.
      </p>
    </div>
  </section>

  <section style="padding:0;background:var(--black)">
    <div class="sec-tag" style="justify-content:center;margin-top:64px;margin-bottom:0">
      Marcas que confían en nosotros
    </div>
    <div class="marquee-wrapper">
      <div class="marquee-content">
        {brands.map((b) => (
          <div class="marquee-item">
            <img src={b.src} alt={b.alt} class="brand-logo" loading="lazy" width="120" height="60" />
            {b.name}
          </div>
        ))}
        <div aria-hidden="true" style="display:contents">
          {brands.map((b) => (
            <div class="marquee-item">
              <img src={b.src} alt="" class="brand-logo" loading="lazy" width="120" height="60" />
              {b.name}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="pcat">
    <div class="pcat-head">
      <div>
        <div class="pcat-num">Proyectos destacados</div>
        <h2 class="pcat-h2">OBRA<br />REALIZADA</h2>
      </div>
      <p class="pcat-desc">
        Una selección de los proyectos más representativos por tipo de obra y cliente. Cada
        proyecto incluye fabricación, instalación y seguimiento postventa.
      </p>
    </div>

    <div class="filter-bar">
      <button class="filter-btn active" data-filter="all">Todos</button>
      <button class="filter-btn" data-filter="carretero">Carretero</button>
      <button class="filter-btn" data-filter="industrial">Industrial</button>
      <button class="filter-btn" data-filter="municipal">Municipal</button>
      <button class="filter-btn" data-filter="aeroportuario">Aeroportuario</button>
    </div>

    <div class="proj-grid" id="projects-container">
      {projects.map((project) => (
        <div class="proj" data-category={project.category}>
          <div class="proj-img">
            <img src={project.img} alt={project.alt} loading="lazy" width="600" height="400" />
          </div>
          <div class="proj-body">
            <div class="proj-tag">{project.tag}</div>
            <div class="proj-title">{project.title}</div>
            <div class="proj-loc">{project.loc}</div>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.proj');
  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      btns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.filter ?? 'all';
      cards.forEach((card) => {
        card.classList.toggle(
          'hidden',
          filter !== 'all' && card.dataset.category !== filter
        );
      });
    });
  });
</script>
