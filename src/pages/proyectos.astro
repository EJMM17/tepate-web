  { img: '/proyectos_nuevos/boyas_carretera_atardecer_1.webp', alt: 'Instalación de boyas amarillas en carretera al atardecer — Monterrey N.L.', tag: 'Municipal', title: 'Confinamiento Vial con Boyas', loc: 'Instalación de boyas amarillas en vialidad — Monterrey, N.L.', category: 'municipal' },
  { img: '/proyectos_nuevos/senalamiento_escolar_mty_1.webp', alt: 'Señal preventiva escolar con Sierra de las Mitras al fondo, Monterrey N.L.', tag: 'Escolar', title: 'Señalamiento Escolar — Monterrey N.L.', loc: 'Señal preventiva con lámina retroreflectiva grado diamante', category: 'municipal' },
  { img: '/proyectos_nuevos/topes_instalacion_equipo.webp', alt: 'Cuadrilla TEPATE instalando topes reductores de velocidad en campo', tag: 'Municipal', title: 'Instalación de Topes Reductores', loc: 'Instalación en campo con cuadrilla propia — Monterrey, N.L.', category: 'municipal' },
  { img: '/proyectos_nuevos/senal_escolar_primer_plano.webp', alt: 'Señal escolar PRECAUCIÓN primer plano con cielo azul de fondo', tag: 'Escolar', title: 'Señal Escolar PRECAUCIÓN', loc: 'Lámina retroreflectiva de alta intensidad — Zona escolar', category: 'municipal' },
  { img: '/proyectos_nuevos/cebra_nocturna_residencial.webp', alt: 'Cebra peatonal pintada de noche en zona residencial — señalamiento horizontal', tag: 'Municipal', title: 'Cebra Peatonal Nocturna', loc: 'Señalamiento horizontal en fraccionamiento residencial', category: 'municipal' },
  { img: '/proyectos_nuevos/cebra_diurna_equipo.webp', alt: 'Equipo TEPATE aplicando señalamiento horizontal en cruce peatonal', tag: 'Municipal', title: 'Aplicación de Cebra Peatonal', loc: 'Cuadrilla aplicando pintura termoplástica en cruce', category: 'municipal' },
  { img: '/proyectos_nuevos/termoplastica_macro_carretera.webp', alt: 'Detalle macro de textura de pintura termoplástica aplicada en carretera', tag: 'Carretero', title: 'Textura Termoplástica en Carretera', loc: 'Detalle de aplicación termoplástica en carpeta asfáltica', category: 'carretero' },
  { img: '/proyectos_nuevos/obra_nocturna_carretera.webp', alt: 'Operación nocturna de señalamiento vial en carretera — cuadrilla TEPATE', tag: 'Carretero', title: 'Obra Nocturna en Carretera', loc: 'Aplicación de señalamiento horizontal en horario nocturno', category: 'carretero' },
  { img: '/01_Senales_Viales/Senial_Zona_Escolar_30kmh_Completa.webp', alt: 'Señalamiento escolar completo con límite 30 km/h', tag: 'Escolar', title: 'Señalización Escolar Completa', loc: 'Zona escolar con señal de velocidad máxima', category: 'municipal' },
  { img: '/01_Senales_Viales/Senial_ALTO_Solar_Luces_2.webp', alt: 'Señal de ALTO con panel solar y luces destellantes', tag: 'Municipal', title: 'Señal ALTO Solar — Vista Nocturna', loc: 'Señal con tecnología LED autónoma', category: 'municipal' },
  { img: '/02_Equipo_Termoplastico/Equipo_Caldera_Azul_TEPATE.webp', alt: 'Caldera termoplástica azul marca TEPATE', tag: 'Fabricación', title: 'Caldera Termoplástica TEPATE', loc: 'Caldera de precalentado fabricada en planta Apodaca', category: 'industrial' },
  { img: '/02_Equipo_Termoplastico/Equipo_Zapata_Doble_Termoplastica.webp', alt: 'Zapata doble para aplicación termoplástica', tag: 'Fabricación', title: 'Zapata Doble Termoplástica', loc: 'Componente de precisión para extrusión de pintura', category: 'industrial' },
  { img: '/03_Trabajos_Senalizacion/Trabajo_Tachones_Carretera_Atardecer.webp', alt: 'Tachones reflectivos en carretera al atardecer', tag: 'Carretero', title: 'Tachones Carreteros — Atardecer', loc: 'Instalación de tachones reflectivos en carretera federal', category: 'carretero' },
  { img: '/03_Trabajos_Senalizacion/Trabajo_Marcaje_SLOW.webp', alt: 'Marcaje SLOW en pavimento con pintura termoplástica', tag: 'Aeroportuario', title: 'Marcaje SLOW en Pista', loc: 'Aplicación de señalamiento horizontal en zona aeroportuaria', category: 'aeroportuario' },
  { img: '/05_Construccion_General/Construccion_Diseno_Carretera_TEPATE.webp', alt: 'Diseño de carretera por ingenieros TEPATE', tag: 'Carretero', title: 'Diseño de Carretera', loc: 'Ingeniería y diseño de vialidades', category: 'carretero' },
  { img: '/05_Construccion_General/Construccion_Ingeniera_Supervision.webp', alt: 'Supervisión de obra por ingeniera TEPATE', tag: 'Carretero', title: 'Supervisión de Obra', loc: 'Control de calidad y supervisión técnica en campo', category: 'carretero' },
