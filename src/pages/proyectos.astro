---
import Layout from '@/layouts/Layout.astro';
import { buildSeo, buildBreadcrumbJsonLd } from '@/lib/seo';
import { COMPANY } from '@/data/navigation';

const seo = buildSeo({
  title: 'Proyectos — Ingeniería Vial TEPATE',
  description:
    'Portafolio de obra TEPATE: Aeropuerto Monterrey, parques industriales, carreteras federales, obras municipales. Más de 500 proyectos entregados en 16 años.',
  canonical: `${COMPANY.url}/proyectos`,
  ogImage: 'https://tepate.com.mx/proyectos_nuevos/obra_nocturna_carretera.webp',
  jsonLd: buildBreadcrumbJsonLd([
    { name: 'Inicio', url: COMPANY.url },
    { name: 'Proyectos', url: `${COMPANY.url}/proyectos` },
  ]),
});

interface Project {
  img: string;
  alt: string;
  tag: string;
  title: string;
  loc: string;
  category: string;
}

const projects: Project[] = [
  { img: '/TEPATE_Imagenes_Organizadas/08_Maquinas_Aplicadoras/slide10_Maquinas_Aplicadoras_img1.webp', alt: 'Máquina aplicadora de pintura termoplástica sobre remolque', tag: 'Fabricación', title: 'Máquinas Aplicadoras', loc: 'Fabricación de máquinas termoplásticas de 200kg a 300kg', category: 'industrial' },
  { img: '/TEPATE_Imagenes_Organizadas/08_Maquinas_Aplicadoras/slide10_Maquinas_Aplicadoras_img2.webp', alt: 'Equipo de aplicación manual de pintura termoplástica', tag: 'Fabricación', title: 'Máquinas Aplicadoras (Serie 200)', loc: 'Equipos compactos de aplicación de pintura termoplástica', category: 'industrial' },
  { img: '/TEPATE_Imagenes_Organizadas/10_Boyas_Vialetas/slide13_Boyas_Vialetas_Aplicacion_img1.webp', alt: 'Instalación de boyas metálicas y vialetas retroreflectivas en vialidad urbana', tag: 'Municipal', title: 'Instalación de Boyas y Vialetas', loc: 'Aplicación en campo para delimitación vial', category: 'municipal' },
  { img: '/03_Trabajos_Senalizacion/Trabajo_Marcaje_Linea_Amarilla_Maquina.webp', alt: 'Aplicación de pintura de tráfico base agua con máquina', tag: 'Municipal', title: 'Pintura Tráfico en Guarnición', loc: 'Aplicación de pintura base agua en bordillos', category: 'municipal' },
  { img: '/TEPATE_Imagenes_Organizadas/16_Senalamiento_Escolar/slide21_Senalamiento_Preventivo_Digital_Escolar_img1.webp', alt: 'Señales preventivas escolares con tecnología destellante digital', tag: 'Escolar', title: 'Señalamiento Preventivo Digital Escolar', loc: 'Señales con tecnología destellante digital', category: 'municipal' },
  { img: '/01_Senales_Viales/Senial_ALTO_3M.webp', alt: 'Señalamiento restrictivo tipo SR con materiales retroreflectivos de grado ingeniería', tag: 'Carretero', title: 'Señalamiento Restrictivo Tipo SR', loc: 'Restricciones de tránsito con materiales retroreflectivos', category: 'carretero' },
  { img: '/01_Senales_Viales/Senial_Curva_Izquierda_20MPH.webp', alt: 'Señalamiento preventivo tipo SP para advertencia de curvas y peligros', tag: 'Carretero', title: 'Señalamiento Preventivo Tipo SP', loc: 'Advertencia de peligro en carreteras y vialidades', category: 'carretero' },
  { img: '/01_Senales_Viales/Senial_Carretera_Nacional_Huajuquito.webp', alt: 'Señales de destino e informativas para rutas federales y estatales', tag: 'Carretero', title: 'Señalamiento de Protección y Destino', loc: 'Indicación de rutas y protección de obra', category: 'carretero' },
  { img: '/01_Senales_Viales/Senial_Puente_Internacional_Instalacion.webp', alt: 'Instalación de señales de protección de obra en zona de construcción', tag: 'Carretero', title: 'Señalamiento de Destino (Rutas)', loc: 'Instalación en rutas federales y estatales', category: 'carretero' },
  { img: '/TEPATE_Imagenes_Organizadas/24_Senalamiento_Vertical_SID15/slide31_Senalamiento_Vertical_Elevado_SID15_img3.webp', alt: 'Estructura de señalamiento vertical elevado tipo bandera SID-15', tag: 'Carretero', title: 'Señalamiento Vertical Elevado SID-15', loc: 'Estructuras elevadas para señalización', category: 'carretero' },
