  { img: '/TEPATE_Imagenes_Organizadas/10_Boyas_Vialetas/slide12_Boyas_Vialetas_Descripcion_img1.webp', alt: 'Boyas metálicas y vialetas para delimitación de carriles en avenidas', tag: 'Municipal', title: 'Boyas y Vialetas', loc: 'Elementos de confinamiento y delimitación vial', category: 'municipal' },
  { img: '/TEPATE_Imagenes_Organizadas/16_Senalamiento_Escolar/slide21_Senalamiento_Preventivo_Digital_Escolar_img2.webp', alt: 'Señalamiento preventivo escolar con leds destellantes para zonas de alta afluencia', tag: 'Escolar', title: 'Señalización Escolar Inteligente', loc: 'Sistemas autónomos de reducción de velocidad', category: 'municipal' },
