---
import Layout from '@/layouts/Layout.astro';
import { buildSeo, buildBreadcrumbJsonLd, buildFaqJsonLd } from '@/lib/seo';
import { COMPANY } from '@/data/navigation';

const serviceFaqs = [
  {
    question: '¿Qué información necesitan para cotizar una obra?',
    answer:
      'Producto o servicio requerido, ubicación, volumen estimado, fecha objetivo y, si aplica, bases de licitación o planos del proyecto.',
  },
  {
    question: '¿Atienden obra pública y privada?',
    answer:
      'Sí. TEPATE atiende dependencias estatales, municipios, constructoras, parques industriales, aeropuertos e iniciativa privada.',
  },
  {
    question: '¿Realizan instalación en campo?',
    answer:
      'Sí. Además de fabricar equipos y señalamiento, ejecutamos instalación, aplicación, supervisión y soporte técnico en obra.',
  },
  {
    question: '¿Pueden emitir propuesta técnica y económica?',
    answer:
      'Sí. Preparamos cotizaciones formales con alcance técnico, condiciones comerciales y tiempos de entrega para revisión del comprador.',
  },
] as const;

const seo = buildSeo({
  title: 'Servicios — Ingeniería Vial TEPATE',
  description:
    'Fabricación termoplástica, señalamiento horizontal y vertical, estudios de ingeniería vial con Synchro Studio v12, y confinamiento de obra. 16 años de experiencia.',
  canonical: `${COMPANY.url}/servicios`,
  ogImage:
    'https://tepate.com.mx/TEPATE_Imagenes_Organizadas/24_Senalamiento_Vertical_SID15/slide31_Senalamiento_Vertical_Elevado_SID15_img1.webp',
  jsonLd: [
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, item: { '@type': 'Service', name: 'Fabricación Termoplástica', description: 'Diseño y manufactura directa de equipos termoplásticos a pedido del cliente.', provider: { '@type': 'Organization', name: COMPANY.legalName }, serviceType: 'Fabricación de Maquinaria Industrial' } },
        { '@type': 'ListItem', position: 2, item: { '@type': 'Service', name: 'Señalamiento Horizontal', description: 'Aplicación profesional de pintura vial en carreteras, avenidas, estacionamientos industriales y aeropuertos.', provider: { '@type': 'Organization', name: COMPANY.legalName }, serviceType: 'Servicios de Señalización Vial' } },
        { '@type': 'ListItem', position: 3, item: { '@type': 'Service', name: 'Señalamiento Vertical', description: 'Fabricación, suministro e instalación de señalamiento vertical bajo y elevado.', provider: { '@type': 'Organization', name: COMPANY.legalName }, serviceType: 'Servicios de Señalización Vial' } },
        { '@type': 'ListItem', position: 4, item: { '@type': 'Service', name: 'Estudios de Ingeniería Vial', description: 'Estudios técnicos para análisis de vialidades, proyectos de semaforización y manifestaciones de impacto vial utilizando Synchro Studio v12.', provider: { '@type': 'Organization', name: COMPANY.legalName }, serviceType: 'Consultoría en Ingeniería Civil y Vial' } },
        { '@type': 'ListItem', position: 5, item: { '@type': 'Service', name: 'Confinamiento Vial', description: 'Suministro e instalación de dispositivos de protección, delimitación y confinamiento de obra.', provider: { '@type': 'Organization', name: COMPANY.legalName }, serviceType: 'Seguridad Vial y Confinamiento' } },
      ],
    },
    buildFaqJsonLd(serviceFaqs),
    buildBreadcrumbJsonLd([
      { name: 'Inicio', url: COMPANY.url },
      { name: 'Servicios', url: `${COMPANY.url}/servicios` },
    ]),
  ],
});
---

<Layout {...seo}>
  <section class="page-header">
    <div class="ph-inner reveal-up">
      <div class="ph-crumb"><a href="/">Inicio</a><span>/</span>Servicios</div>
      <h1 class="ph-title">SERVICIOS <span class="acc">ESPECIALIZADOS</span></h1>
      <p class="ph-lead">
        Especialistas resolviendo necesidades de ingeniería civil, arquitectura, ingeniería vial y
        estudios viales en semaforización, aeropuertos, ciclovías y fabricación de equipos
        termoplásticos. Desarrollamos soluciones con ética y profesionalismo para clientes
        estatales, municipales e iniciativa privada.
      </p>
    </div>
  </section>



  <!-- 01 FABRICACIÓN -->
  <section class="pcat accordion-item active reveal-up" id="fabricacion">
    <button class="accordion-trigger" aria-expanded="true" aria-controls="content-fabricacion">
      <div class="pcat-head">
        <div class="accordion-header-inner">
          <div>
            <div class="pcat-num">01 · Servicio</div>
            <h2 class="pcat-h2">FABRICACIÓN DE EQUIPOS<br />TERMOPLÁSTICOS</h2>
          </div>
          <svg class="accordion-icon" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
        <p class="pcat-desc">
          Diseño y manufactura directa de equipos termoplásticos a pedido: calderas de 400 a
          2,000 kg, máquinas aplicadoras, dados y zapatas. 100% hidráulicos con motores Kohler y
          componentes Continental, Parker y Vickers. No somos distribuidores — fabricamos desde
          ingeniería hasta entrega en sitio. <strong>No fabricamos pintura termoplástica —
          fabricamos los equipos que la aplican.</strong>
        </p>
      </div>
    </button>
    <div class="accordion-content" id="content-fabricacion" role="region">
      <div class="duo">
        <div class="duo-panel">
          <div class="duo-label">Qué fabricamos</div>
          <div class="duo-title">Equipos a medida</div>
          <div class="duo-body">
            <p>Diseñamos cada caldera, máquina aplicadora y dado según la capacidad y requerimientos del equipo de movilidad del cliente. Todo el sistema es 100% hidráulico, con componentes de marcas líderes.</p>
            <ul>
              <li>Calderas de precalentado 400 a 2,000 kg</li>
              <li>Calderas sobre remolque 3.5 y 5.0 toneladas</li>
              <li>Máquinas aplicadoras con tanques 200, 250 y 300 kg</li>
              <li>Dados y zapatas de 10, 15, 20, 30, 40 y 60 cm</li>
              <li>Sistemas con doble cilindraje opcional</li>
            </ul>
          </div>
        </div>
        <div class="duo-panel">
          <div class="duo-label">Componentes de marca</div>
          <div class="duo-title">Calidad garantizada</div>
          <div class="duo-body">
            <p>Trabajamos exclusivamente con marcas líderes en sistemas hidráulicos, motores y controles industriales para garantizar durabilidad y refacciones disponibles en todo México.</p>
            <ul>
              <li><strong>Kohler</strong> · Motores Command Pro y Quad-Clean</li>
              <li><strong>Continental</strong> · Mangueras de alta presión</li>
              <li><strong>Parker</strong> · Conexiones hidráulicas</li>
              <li><strong>Vickers</strong> · Válvulas y bombas</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="fabrica-photos" style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:32px;">
        <img src="/02_Equipo_Termoplastico/Equipo_Caldera_Termoplastica_Trailer.webp" alt="Caldera termoplástica sobre remolque TEPATE" loading="lazy" decoding="async" style="width:100%;aspect-ratio:4/3;object-fit:cover;" />
        <img src="/02_Equipo_Termoplastico/Equipo_Caldera_Termoplastica_Blanca.webp" alt="Caldera termoplástica blanca TEPATE" loading="lazy" decoding="async" style="width:100%;aspect-ratio:4/3;object-fit:cover;" />
        <img src="/02_Equipo_Termoplastico/Equipo_Caldera_Azul_Detalle.webp" alt="Detalle de caldera termoplástica azul TEPATE" loading="lazy" decoding="async" style="width:100%;aspect-ratio:4/3;object-fit:cover;" />
        <img src="/02_Equipo_Termoplastico/Equipo_Caldera_Azul_Trasera.webp" alt="Vista trasera de caldera termoplástica azul TEPATE" loading="lazy" decoding="async" style="width:100%;aspect-ratio:4/3;object-fit:cover;" />
      </div>
      <div class="svc-cta-row">
        <a href="/contacto?interes=fabricacion&servicio=Fabricación%20Termoplástica" class="btn-primary" style="font-size:12px;padding:14px 24px;">Solicitar cotización de fabricación →</a>
        <a href="https://wa.me/528118959042?text=Hola%2C%20solicito%20cotización%20para%20fabricación%20termoplástica" target="_blank" rel="noopener noreferrer" class="btn-ghost" style="font-size:12px;padding:14px 24px;">Asesoría por WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- 02 SEÑALAMIENTO HORIZONTAL -->
  <section class="pcat accordion-item reveal-up" id="horizontal">
    <button class="accordion-trigger" aria-expanded="false" aria-controls="content-horizontal">
      <div class="pcat-head">
        <div class="accordion-header-inner">
          <div>
            <div class="pcat-num">02 · Servicio</div>
            <h2 class="pcat-h2">SEÑALAMIENTO HORIZONTAL<br />Y PINTURA VIAL</h2>
          </div>
          <svg class="accordion-icon" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
        <p class="pcat-desc">
          Aplicación de los tres tipos de pintura vial: termoplástica (AASHTO, SCT México, TxDOT),
          tráfico base agua y epóxica. Para guarniciones, calles, carreteras, aeropuertos y zonas
          industriales. Experiencia en obra pública y privada, incluyendo pista y rampas del
          Aeropuerto de Monterrey.
        </p>
      </div>
    </button>
    <div class="accordion-content" id="content-horizontal" role="region">
      <div class="duo">
        <div class="duo-panel">
          <div class="duo-label">Tipos de aplicación</div>
          <div class="duo-title">Pintura vial</div>
          <div class="duo-body">
            <p>Aplicamos todos los tipos de pintura normativamente aprobados para uso vial según el proyecto y su exposición.</p>
            <ul>
              <li>Pintura tráfico base agua</li>
              <li>Pintura epóxica para guarniciones</li>
              <li>Termoplástica extrusión en caliente</li>
              <li>Pintura horneada para pistas de aeropuerto</li>
              <li>Aplicación con microesferas reflectivas</li>
            </ul>
          </div>
        </div>
        <div class="duo-panel">
          <div class="duo-label">Proveedores</div>
          <div class="duo-title">Materiales certificados</div>
          <div class="duo-body">
            <p>Solo utilizamos pinturas y termoplásticos de proveedores con certificación internacional para uso vial y aeroportuario.</p>
            <ul>
              <li><strong>Ennis-Flint</strong> · The Mark of Traffic Safety</li>
              <li><strong>Swarco</strong> · Road Marking Systems</li>
              <li><strong>Crown Technology</strong> · Termoplásticos industriales</li>
              <li><strong>Dynakrom · Voller · Comex</strong> · Línea mexicana</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="fabrica-photos" style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:32px;">
        <img src="/03_Trabajos_Senalizacion/Trabajo_Cruce_Peatonal_Nocturno.webp" alt="Cruce peatonal nocturno con pintura termoplástica" loading="lazy" decoding="async" style="width:100%;aspect-ratio:4/3;object-fit:cover;" />
        <img src="/03_Trabajos_Senalizacion/Trabajo_Linea_Doble_Amarilla_Nocturno.webp" alt="Marcaje de línea doble amarilla nocturno en carretera" loading="lazy" decoding="async" style="width:100%;aspect-ratio:4/3;object-fit:cover;" />
        <img src="/03_Trabajos_Senalizacion/Trabajo_Linea_Doble_Amarilla_Detalle.webp" alt="Detalle de línea doble amarilla en carretera" loading="lazy" decoding="async" style="width:100%;aspect-ratio:4/3;object-fit:cover;" />
        <img src="/03_Trabajos_Senalizacion/Trabajo_Marcaje_Aeropuerto_Comex_Interjet.webp" alt="Marcaje en rampa de aeropuerto" loading="lazy" decoding="async" style="width:100%;aspect-ratio:4/3;object-fit:cover;" />
      </div>
      <div class="svc-cta-row">
        <a href="/contacto?interes=horizontal&servicio=Señalamiento%20Horizontal" class="btn-primary" style="font-size:12px;padding:14px 24px;">Cotizar señalamiento horizontal →</a>
        <a href="https://wa.me/528118959042?text=Hola%2C%20solicito%20cotización%20para%20señalamiento%20horizontal" target="_blank" rel="noopener noreferrer" class="btn-ghost" style="font-size:12px;padding:14px 24px;">WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- 03 SEÑALAMIENTO VERTICAL -->
  <section class="pcat accordion-item reveal-up" id="vertical">
    <button class="accordion-trigger" aria-expanded="false" aria-controls="content-vertical">
      <div class="pcat-head">
        <div class="accordion-header-inner">
          <div>
            <div class="pcat-num">03 · Servicio</div>
            <h2 class="pcat-h2">SEÑALAMIENTO<br />VERTICAL</h2>
          </div>
          <svg class="accordion-icon" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
        <p class="pcat-desc">
          Fabricación, suministro e instalación de señalamiento vertical bajo y elevado. Contamos
          con grúa-pluma para instalación de pórticos SID-13 y SID-15 en carreteras y parques
          industriales.
        </p>
      </div>
    </button>
    <div class="accordion-content" id="content-vertical" role="region">
      <div class="duo">
        <div class="duo-panel">
          <div class="duo-label">Tipos de señalamiento</div>
          <div class="duo-title">Catálogo completo</div>
          <div class="duo-body">
            <p>Fabricamos todos los tipos reconocidos por la Secretaría de Infraestructura, Comunicaciones y Transportes para vialidad mexicana.</p>
            <ul>
              <li>Restrictivo (SR) · SR-6 al SR-37</li>
              <li>Preventivo (SP) · SP-6 al SP-49</li>
              <li>Informativo de servicio (SIS) · SIS-1 al SIT-10</li>
              <li>Informativo de destino (SID) · SID-8 al SID-15</li>
              <li>Destellantes con panel solar</li>
              <li>Nomenclatura colonial para municipios</li>
            </ul>
          </div>
        </div>
        <div class="duo-panel">
          <div class="duo-label">Reflectividad</div>
          <div class="duo-title">Grados disponibles</div>
          <div class="duo-body">
            <p>Trabajamos con las tres marcas líderes mundiales en películas reflectivas. Seleccionamos el grado según el tipo de vialidad, velocidad de operación y presupuesto del proyecto.</p>
            <ul>
              <li><strong>Grado Ingeniería</strong> · Costo bajo (fuera de norma federal)</li>
              <li><strong>Grado Alta Intensidad</strong> · Gama media, dentro de norma</li>
              <li><strong>Grado Diamante</strong> · Gama alta, máximo desempeño</li>
              <li>Películas <strong>3M</strong> y <strong>Avery Dennison</strong></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="fabrica-photos" style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:32px;">
        <img src="/01_Senales_Viales/Senial_ALTO_Matera_Porto.webp" alt="Señal de ALTO instalada en vialidad urbana" loading="lazy" decoding="async" style="width:100%;aspect-ratio:4/3;object-fit:cover;" />
        <img src="/01_Senales_Viales/Senial_Zona_Escolar_Precaucion.webp" alt="Señalamiento preventivo escolar de zona escolar" loading="lazy" decoding="async" style="width:100%;aspect-ratio:4/3;object-fit:cover;" />
        <img src="/01_Senales_Viales/Senial_Zona_Escolar_Solar_Reversa.webp" alt="Señal escolar solar destellante vista reversa" loading="lazy" decoding="async" style="width:100%;aspect-ratio:4/3;object-fit:cover;" />
        <img src="/TEPATE_Imagenes_Organizadas/24_Senalamiento_Vertical_SID15/slide31_Senalamiento_Vertical_Elevado_SID15_img1.webp" alt="Estructura elevada tipo pórtico SID-15" loading="lazy" decoding="async" style="width:100%;aspect-ratio:4/3;object-fit:cover;" />
      </div>
      <div class="svc-cta-row">
        <a href="/contacto?interes=vertical&servicio=Señalamiento%20Vertical" class="btn-primary" style="font-size:12px;padding:14px 24px;">Cotizar señalamiento vertical →</a>
        <a href="https://wa.me/528118959042?text=Hola%2C%20solicito%20cotización%20para%20señalamiento%20vertical" target="_blank" rel="noopener noreferrer" class="btn-ghost" style="font-size:12px;padding:14px 24px;">WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- 04 ESTUDIOS -->
  <section class="pcat accordion-item reveal-up" id="estudios">
    <button class="accordion-trigger" aria-expanded="false" aria-controls="content-estudios">
      <div class="pcat-head">
        <div class="accordion-header-inner">
          <div>
            <div class="pcat-num">04 · Servicio</div>
            <h2 class="pcat-h2">ESTUDIOS DE<br />INGENIERÍA VIAL</h2>
          </div>
          <svg class="accordion-icon" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
        <p class="pcat-desc">
          Estudios técnicos para análisis de vialidades, proyectos de semaforización y
          manifestaciones de impacto vial. Utilizamos Synchro Studio v12 con HCM 7th Edition,
          software estándar de la industria.
        </p>
      </div>
    </button>
    <div class="accordion-content" id="content-estudios" role="region">
      <div class="duo">
        <div class="duo-panel">
          <div class="duo-label">Alcance técnico</div>
          <div class="duo-title">Estudios con Synchro Traffic</div>
          <div class="duo-body">
            <p>Realizamos los estudios necesarios para sustentar proyectos de obra pública y manifestaciones ante autoridades de desarrollo urbano.</p>
            <ul>
              <li>Impacto vial (MIV)</li>
              <li>Recorridos y demoras</li>
              <li>Aforos vehiculares</li>
              <li>Aforos peatonales</li>
              <li>Estudios de ciclovías</li>
              <li>Proyectos de semaforización</li>
            </ul>
          </div>
        </div>
        <div class="duo-panel">
          <div class="duo-label">Herramientas</div>
          <div class="duo-title">Software profesional</div>
          <div class="duo-body">
            <p>Synchro Studio v12 es el estándar de Cubic Transportation para análisis de intersecciones semaforizadas y modelación de redes viales.</p>
            <ul>
              <li><strong>Synchro Studio v12</strong> · Enhanced Scenario Manager</li>
              <li><strong>HCM 7th Edition</strong> · Highway Capacity Manual</li>
              <li>Modelación de intersecciones complejas</li>
              <li>Reportes técnicos profesionales</li>
              <li>Entregables en PDF y nativos</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="svc-cta-row">
        <a href="/contacto?interes=estudios&servicio=Estudios%20de%20Ingeniería%20Vial" class="btn-primary" style="font-size:12px;padding:14px 24px;">Cotizar estudios técnicos →</a>
        <a href="https://wa.me/528118959042?text=Hola%2C%20solicito%20cotización%20para%20estudios%20de%20ingeniería%20vial" target="_blank" rel="noopener noreferrer" class="btn-ghost" style="font-size:12px;padding:14px 24px;">WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- 05 CONFINAMIENTO -->
  <section class="pcat accordion-item reveal-up" id="confinamiento">
    <button class="accordion-trigger" aria-expanded="false" aria-controls="content-confinamiento">
      <div class="pcat-head">
        <div class="accordion-header-inner">
          <div>
            <div class="pcat-num">05 · Servicio</div>
            <h2 class="pcat-h2">CONFINAMIENTO<br />VIAL</h2>
          </div>
          <svg class="accordion-icon" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
        <p class="pcat-desc">
          Suministro e instalación de dispositivos de protección, delimitación y confinamiento de
          obra. Atendemos proyectos de obra pública, industria, estacionamientos y vialidades.
        </p>
      </div>
    </button>
    <div class="accordion-content" id="content-confinamiento" role="region">
      <div class="duo">
        <div class="duo-panel">
          <div class="duo-label">Qué incluye</div>
          <div class="duo-title">Dispositivos disponibles</div>
          <div class="duo-body">
            <p>Colocación profesional con equipo propio y personal capacitado. Contamos con certificaciones de seguridad para trabajo en vialidades activas.</p>
            <ul>
              <li>Colocación de boyas y vialetas</li>
              <li>Colocación de tachuelas de aluminio</li>
              <li>Instalación de delineadores flexibles</li>
              <li>Anclado de bordos reductores Easy Rider</li>
              <li>Montaje de trafitambos y barreras</li>
            </ul>
          </div>
        </div>
        <div class="duo-panel">
          <div class="duo-label">Proyectos típicos</div>
          <div class="duo-title">Aplicaciones</div>
          <div class="duo-body">
            <p>Hemos ejecutado proyectos de confinamiento en carreteras federales, parques industriales, centros comerciales y zonas residenciales del noreste de México.</p>
            <ul>
              <li>Delimitación de carriles y zonas neutras</li>
              <li>Configuración de isletas</li>
              <li>Alineación de ciclovías</li>
              <li>Protección de obra en vía pública</li>
              <li>Estacionamientos industriales</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="fabrica-photos" style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:32px;">
        <img src="/03_Trabajos_Senalizacion/Trabajo_Tachones_Carretera_3.webp" alt="Tachones reflectivos instalados en carretera" loading="lazy" decoding="async" style="width:100%;aspect-ratio:4/3;object-fit:cover;" />
        <img src="/03_Trabajos_Senalizacion/Trabajo_Tachones_Carretera_Atardecer_2.webp" alt="Tachones en carretera al atardecer" loading="lazy" decoding="async" style="width:100%;aspect-ratio:4/3;object-fit:cover;" />
        <img src="/03_Trabajos_Senalizacion/Trabajo_Instalacion_Tachones_Nocturno.webp" alt="Instalación nocturna de tachones en vialidad" loading="lazy" decoding="async" style="width:100%;aspect-ratio:4/3;object-fit:cover;" />
        <img src="/03_Trabajos_Senalizacion/Trabajo_Tachones_Nocturno.webp" alt="Tachones reflectivos en operación nocturna" loading="lazy" decoding="async" style="width:100%;aspect-ratio:4/3;object-fit:cover;" />
      </div>
      <div class="svc-cta-row">
        <a href="/contacto?interes=confinamiento-svc&servicio=Confinamiento%20Vial" class="btn-primary" style="font-size:12px;padding:14px 24px;">Cotizar confinamiento →</a>
        <a href="https://wa.me/528118959042?text=Hola%2C%20solicito%20cotización%20para%20confinamiento%20vial" target="_blank" rel="noopener noreferrer" class="btn-ghost" style="font-size:12px;padding:14px 24px;">WhatsApp</a>
      </div>
    </div>
  </section>

