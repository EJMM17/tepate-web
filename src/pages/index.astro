---
import Layout from '@/layouts/Layout.astro';
import ContactForm from '@/components/ContactForm.tsx';
import { buildSeo, buildLocalBusinessJsonLd } from '@/lib/seo';
import { COMPANY } from '@/data/navigation';

const brands = [
  // Clientes principales
  { src: '/TEPATE_Marcas/Principales_Clientes/Mercedes_Benz.png',               alt: 'Mercedes-Benz' },
  { src: '/TEPATE_Marcas/Principales_Clientes/OMA_Aeropuertos.png',              alt: 'OMA Aeropuertos' },
  { src: '/TEPATE_Marcas/Principales_Clientes/ICA_transparent.png',              alt: 'ICA' },
  { src: '/TEPATE_Marcas/Principales_Clientes/Stiva_transparent.png',            alt: 'Stiva' },
  { src: '/TEPATE_Marcas/Principales_Clientes/Vitro_transparent.png',            alt: 'Vitro' },
  { src: '/TEPATE_Marcas/Principales_Clientes/FRISA_transparent.png',            alt: 'FRISA' },
  { src: '/TEPATE_Marcas/Principales_Clientes/Solvay.png',                       alt: 'Solvay' },
  { src: '/TEPATE_Marcas/Principales_Clientes/Grupo_Calidra_transparent.png',    alt: 'Grupo Calidra' },
  { src: '/TEPATE_Marcas/Principales_Clientes/GP_Construccion_transparent.png',  alt: 'GP Construcción' },
  { src: '/TEPATE_Marcas/Principales_Clientes/IDEI_Construyendo_Mexico.webp',    alt: 'IDEI' },
  { src: '/TEPATE_Marcas/Principales_Clientes/Daewoo_transparent.png',           alt: 'Daewoo' },
  { src: '/TEPATE_Marcas/Principales_Clientes/Nutrioli_transparent.png',         alt: 'Nutrioli' },
  { src: '/TEPATE_Marcas/Principales_Clientes/Gruma.png',                        alt: 'Gruma' },
  // Proveedores
  { src: '/TEPATE_Marcas/Laminas_Senalamiento/3M.webp',                          alt: '3M' },
  { src: '/TEPATE_Marcas/Laminas_Senalamiento/Avery_Dennison_transparent.png',   alt: 'Avery Dennison' },
  { src: '/TEPATE_Marcas/Laminas_Senalamiento/Ennis_Flint_transparent.png',      alt: 'Ennis-Flint' },
  { src: '/TEPATE_Marcas/Laminas_Senalamiento/Sherwin_Williams.png',             alt: 'Sherwin Williams' },
  { src: '/TEPATE_Marcas/Materiales_Termoplasticos/SWARCO_Road_Marking_transparent.png', alt: 'Swarco' },
  { src: '/TEPATE_Marcas/Materiales_Termoplasticos/Crown_Technology_transparent.png',    alt: 'Crown Technology' },
  { src: '/TEPATE_Marcas/Materiales_Termoplasticos/Dynakrom_transparent.png',    alt: 'Dynakrom' },
  { src: '/TEPATE_Marcas/Materiales_Termoplasticos/Comex_Termoplastico.webp',    alt: 'Comex' },
  { src: '/TEPATE_Marcas/Componentes_Calderas/Kohler_motores_transparent.png',   alt: 'Kohler' },
  { src: '/TEPATE_Marcas/Componentes_Calderas/Continental_transparent.png',      alt: 'Continental' },
  { src: '/TEPATE_Marcas/Componentes_Calderas/Parker_Hannifin_transparent.png',  alt: 'Parker Hannifin' },
  { src: '/TEPATE_Marcas/Componentes_Calderas/Vickers_hidraulica_transparent.png', alt: 'Vickers' },
] as const;

const seo = buildSeo({
  title: 'Señalamiento vial y calderas termoplásticas en México | TEPATE',
  description:
    'Fabricación e instalación de señalamiento vial, calderas termoplásticas, máquinas aplicadoras, señalamiento horizontal y vertical. Envíos a todo México y cumplimiento SCT/ASTM.',
  canonical: `${COMPANY.url}/`,
  jsonLd: buildLocalBusinessJsonLd(),
});
---

<Layout {...seo}>
  <!-- ═══════════════════════════════════════════════════════════
       HERO — Cinematic Editorial Layout
       Monumental typography, asymmetric grid, parallax depth
       ═══════════════════════════════════════════════════════════ -->
  <section class="hero" aria-label="Inicio">
    <div class="hero-left">
      <span class="hero-fabrica">FABRICACIÓN DIRECTA</span>

      <h1 class="hero-h1">
        <span class="line">Soluciones de señalamiento vial</span>
        <span class="line">y equipo termoplástico</span>
        <span class="line">para obra pública, industria</span>
        <span class="line acc">y carreteras.</span>
      </h1>

      <p class="hero-sub">
        Fabricamos e instalamos calderas termoplásticas, máquinas aplicadoras, señalamiento horizontal y vertical, dispositivos de confinamiento y equipos solares. Fabricación directa en Nuevo León, envíos a todo México y cumplimiento SCT/ASTM.
      </p>

      <div class="hero-actions">
        <a href="/contacto" class="btn-primary magnetic">
          <span>Solicitar cotización formal</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="/calderas-termoplasticas-tepate.pdf" download class="btn-ghost magnetic">
          <span>Descargar catálogo técnico</span>
        </a>
      </div>



	    </div>

    <div class="hero-right">
      <div class="hero-visual">
        {/* TODO CLIENT: reemplazar con video real de aplicación de termoplástica cuando el cliente lo proporcione */}
        <img
          class="hero-bg-img parallax-img"
          src="/proyectos_nuevos/termoplastica_macro_carretera.webp"
          alt=""
          aria-hidden="true"
          loading="eager"
          decoding="async"
        />
        <div class="hero-visual-overlay"></div>

        <!-- Scroll indicator -->
        <div class="hero-scroll" aria-hidden="true">
          <span class="hero-scroll-l">Scroll</span>
          <div class="hero-scroll-line"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       MARQUEE — Brand logos
       ═══════════════════════════════════════════════════════════ -->
  <section style="padding:0;background:var(--black)">
    <div class="sec-tag reveal-up" style="justify-content:center;margin-top:clamp(32px,6vw,64px);margin-bottom:0">
      Experiencia, materiales y componentes que respaldan nuestros proyectos
    </div>
    <div class="marquee-wrapper reveal-up">
      <div class="marquee-content">
        {brands.map((b) => (
          <div class="marquee-item">
            <img src={b.src} alt={b.alt} class="brand-logo" loading="lazy" width="120" height="60" />
          </div>
        ))}
        <div aria-hidden="true" style="display:contents">
          {brands.map((b) => (
            <div class="marquee-item">
              <img src={b.src} alt="" class="brand-logo" loading="lazy" width="120" height="60" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       BENTO GRID — Product lines showcase
       Asymmetric, magazine-style product presentation
       ═══════════════════════════════════════════════════════════ -->
  <section class="prod-bento-section" aria-labelledby="prods-bento-heading">
    <div class="prod-bento-header reveal-up">
      <span id="prods-bento-heading" class="prod-bento-eyebrow">Nuestras Líneas</span>
      <a href="/productos" class="prod-bento-all magnetic">Catálogo completo →</a>
    </div>

    <div class="prod-bento-grid reveal-stagger">
      <!-- 01 — CALDERAS (featured, spans 2 rows on desktop) -->
      <a href="/productos?cat=calderas" class="pbc pbc--featured">
        <span class="pbc-num">01</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <rect x="3" y="7" width="18" height="12"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="8" y1="7" x2="8" y2="4"/>
            <line x1="12" y1="7" x2="12" y2="4"/>
            <line x1="16" y1="7" x2="16" y2="4"/>
          </svg>
        </div>
        <p class="pbc-name">Calderas Termoplásticas</p>
        <p class="pbc-desc">100% hidráulicas, diseñadas sobre pedido. Doble cilindraje disponible. Componentes Kohler, Parker y Vickers. Unidades individuales o sobre remolque.</p>
        <span class="pbc-tags">400 kg · 500 kg · 1,000 kg · 2,000 kg</span>
        <span class="pbc-link">Ver modelos →</span>
      </a>

      <!-- 02 — MÁQUINAS APLICADORAS -->
      <a href="/productos?cat=maquinas" class="pbc">
        <span class="pbc-num">02</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <rect x="2" y="8" width="14" height="8"/>
            <rect x="4" y="16" width="4" height="3"/>
            <rect x="11" y="16" width="4" height="3"/>
            <line x1="16" y1="12" x2="21" y2="12"/>
            <line x1="19" y1="9" x2="21" y2="12"/>
          </svg>
        </div>
        <p class="pbc-name">Máquinas Aplicadoras</p>
        <span class="pbc-tags">200 kg · 250 kg · 300 kg</span>
        <span class="pbc-link">Ver →</span>
      </a>

      <!-- 03 — SEÑALAMIENTO HORIZONTAL -->
      <a href="/productos?cat=senalamiento" class="pbc">
        <span class="pbc-num">03</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </div>
        <p class="pbc-name">Señalamiento Horizontal</p>
        <span class="pbc-tags">Termoplástica AASHTO · SCT</span>
        <span class="pbc-link">Ver →</span>
      </a>

      <!-- 04 — SEÑALAMIENTO VERTICAL -->
      <a href="/productos?cat=senalamiento" class="pbc">
        <span class="pbc-num">04</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M12 2l10 10-10 10L2 12z"/>
            <line x1="12" y1="8" x2="12" y2="14"/>
            <line x1="12" y1="16.5" x2="12" y2="17"/>
          </svg>
        </div>
        <p class="pbc-name">Señalamiento Vertical</p>
        <span class="pbc-tags">Bajo · Elevado · SR / SP / SIS</span>
        <span class="pbc-link">Ver →</span>
      </a>

      <!-- 05 — CONFINAMIENTO -->
      <a href="/productos?cat=confinamiento" class="pbc">
        <span class="pbc-num">05</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <rect x="2" y="10" width="20" height="4"/>
            <line x1="6" y1="10" x2="5" y2="6"/>
            <line x1="18" y1="10" x2="19" y2="6"/>
            <line x1="6" y1="14" x2="5" y2="18"/>
            <line x1="18" y1="14" x2="19" y2="18"/>
          </svg>
        </div>
        <p class="pbc-name">Dispositivos de Confinamiento</p>
        <span class="pbc-tags">Confinamiento · Delimitación</span>
        <span class="pbc-link">Ver →</span>
      </a>

      <!-- 06 — EQUIPOS SOLAR -->
      <a href="/productos?cat=solar" class="pbc">
        <span class="pbc-num">06</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <rect x="3" y="3" width="7" height="7"/>
            <rect x="14" y="3" width="7" height="7"/>
            <rect x="3" y="14" width="7" height="7"/>
            <rect x="14" y="14" width="7" height="7"/>
          </svg>
        </div>
        <p class="pbc-name">Equipos con Panel Solar</p>
        <span class="pbc-tags">Destellantes · Vial</span>
        <span class="pbc-link">Ver →</span>
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       QUICK QUOTE — B2B conversion strip
       ═══════════════════════════════════════════════════════════ -->
  <section class="quick-quote" aria-label="Cotización rápida">
    <div class="quick-quote-inner reveal-up">
      <div class="quick-quote-head">
        <span class="sec-tag">Cotización empresarial</span>
        <h2 class="sec-h2">¿Necesitas una <span class="acc">cotización formal?</span></h2>
        <p class="quick-quote-lead">Atendemos licitaciones, obra pública y proyectos privados. Entrega de propuesta técnica y económica en PDF en menos de 24 horas hábiles.</p>
      </div>
      <div class="quick-quote-grid">
        <div class="qq-step">
          <div class="qq-num">01</div>
          <h3 class="qq-title">Cuéntanos tu proyecto</h3>
          <p class="qq-desc">Selecciona el producto o servicio, indica volumen estimado y ubicación. Adjunta bases de licitación si aplica.</p>
        </div>
        <div class="qq-step">
          <div class="qq-num">02</div>
          <h3 class="qq-title">Análisis técnico</h3>
          <p class="qq-desc">Nuestros ingenieros revisan especificaciones, normativa aplicable y logística para entregar una propuesta precisa.</p>
        </div>
        <div class="qq-step">
          <div class="qq-num">03</div>
          <h3 class="qq-title">Propuesta en 24h</h3>
          <p class="qq-desc">Recibes cotización formal en PDF con especificaciones técnicas, tiempos de entrega y condiciones comerciales.</p>
        </div>
      </div>
      <div class="quick-quote-actions">
        <a href="/contacto" class="btn-primary magnetic">Iniciar cotización →</a>
        <a href="{whatsappUrl}" target="_blank" rel="noopener noreferrer" class="btn-ghost">Asesoría por WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       TRUST BAND — Stats & credibility
       Full-width numerical impact
       ═══════════════════════════════════════════════════════════ -->
  <section class="trust-band" aria-label="Estadísticas de la empresa">
    <div class="trust-grid">
      <div class="trust-item reveal-up">
        <span class="trust-n" data-value="16">16</span>
        <span class="trust-plus">+</span>
        <span class="trust-l">Años de experiencia</span>
      </div>
      <div class="trust-item reveal-up">
        <span class="trust-n" data-value="500">500</span>
        <span class="trust-plus">+</span>
        <span class="trust-l">Proyectos ejecutados</span>
      </div>
      <div class="trust-item reveal-up">
        <span class="trust-n" data-value="32">32</span>
        <span class="trust-l">Estados de México</span>
      </div>
      <div class="trust-item reveal-up">
        <span class="trust-n">SCT</span>
        <span class="trust-l">Norma N-CMT-5-001-13</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       WHY TEPATE — Editorial split layout
       ═══════════════════════════════════════════════════════════ -->
  <section class="why-editorial" aria-labelledby="why-heading">
    <div class="why-visual reveal-up">
      <div class="why-img-wrap">
        <img src="/TEPATE_Imagenes_Organizadas/03_Informacion_Empresa/slide03_Informacion_General_Empresa_img1.webp" alt="Planta de fabricación TEPATE en Apodaca" loading="lazy" class="parallax-img" />
      </div>
      <div class="why-img-caption">
        <span class="trophy-badge">Planta Apodaca, NL</span>
      </div>
    </div>

    <div class="why-content">
      <div class="reveal-up">
        <span class="sec-tag">Por qué elegirnos</span>
        <h2 id="why-heading" class="sec-h2">
          Ingeniería que<br/><span class="acc">cumple.</span>
        </h2>
      </div>

      <div class="why-list reveal-stagger">
        <div class="why-item">
          <span class="why-num">01</span>
          <div>
            <h3 class="why-title">Fabricación propia</h3>
            <p class="why-desc">Diseñamos y construimos cada equipo en nuestra planta de Apodaca. Control total de calidad, sin intermediarios.</p>
          </div>
        </div>
        <div class="why-item">
          <span class="why-num">02</span>
          <div>
            <h3 class="why-title">Normativa SCT & ASTM</h3>
            <p class="why-desc">Todos nuestros productos cumplen con la Norma N-CMT-5-001-13 de la SCT y estándares ASTM internacionales.</p>
          </div>
        </div>
        <div class="why-item">
          <span class="why-num">03</span>
          <div>
            <h3 class="why-title">Envíos nacionales</h3>
            <p class="why-desc">Entregamos en los 32 estados de México. Logística propia y tiempos de entrega competitivos.</p>
          </div>
        </div>
        <div class="why-item">
          <span class="why-num">04</span>
          <div>
            <h3 class="why-title">Soporte técnico</h3>
            <p class="why-desc">Asesoría en campo, capacitación de operadores y mantenimiento preventivo post-venta.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       CTA BAND — High-contrast conversion zone
       ═══════════════════════════════════════════════════════════ -->
  <section class="cta-band" aria-label="Cotización">
    <div class="cta-inner">
      <div class="reveal-up">
        <h2 class="cta-h2">
          ¿Tienes un proyecto<br/>de señalización?
        </h2>
        <p class="cta-sub">
          Recibe una propuesta técnica y económica en menos de 24 horas hábiles.
          Sin compromiso.
        </p>
      </div>
      <div class="cta-side reveal-up">
        <a href="/contacto" class="btn-dark magnetic">
          <span>Iniciar cotización</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <span class="cta-aside">Respuesta garantizada en 24h</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       CONTACT — Minimal, confident form
       ═══════════════════════════════════════════════════════════ -->
  <section class="contact-section" aria-labelledby="contacto-heading">
    <div class="contact-inner">
      <div class="contact-head reveal-up">
        <span class="sec-tag">Contáctanos</span>
        <h2 id="contacto-heading" class="sec-h2">
          Cuéntanos tu<br/><span class="acc">proyecto.</span>
        </h2>
        <p class="contact-lead">
          Respondemos en menos de 24 horas hábiles. Sin spam, sin compromiso.
        </p>
      </div>
      <div class="contact-form-wrap reveal-up">
        <ContactForm client:visible />
      </div>
    </div>
  </section>
</Layout>
