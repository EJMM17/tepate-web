---
import Layout from '@/layouts/Layout.astro';
import ContactForm from '@/components/ContactForm.tsx';
import { buildSeo, buildLocalBusinessJsonLd } from '@/lib/seo';
import { COMPANY } from '@/data/navigation';

const seo = buildSeo({
  title: 'INGENIERÍA VIAL TEPATE — Fomentando la Cultura Vial y sus Valores',
  description:
    'Fabricación e instalación de calderas termoplásticas, señalamiento horizontal y vertical, dispositivos de protección y equipos solares. Cumplimiento SCT N-CMT-5-001-13 y ASTM. Envíos en todo México.',
  canonical: `${COMPANY.url}/`,
  jsonLd: buildLocalBusinessJsonLd(),
});
---

<Layout {...seo}>
  <!-- ═══════════════════════════════════════════════════════════
       HERO — Cinematic Editorial Layout
       Monumental typography, asymmetric grid, parallax depth
       ═══════════════════════════════════════════════════════════ -->
  <section class="hero" aria-label="Inicio">
    <div class="hero-left">
      <span class="eyebrow">
        <span class="dot"></span>
        16 años · SCT N-CMT-5-001-13 · ASTM
      </span>

      <span class="hero-fabrica">FABRICACIÓN</span>

      <h1 class="hero-h1">
        <span class="line">Forjamos la</span>
        <span class="line">Infraestructura</span>
        <span class="line">de México con</span>
        <span class="line acc">Fuerza y Orgullo Regio.</span>
      </h1>

      <p class="hero-sub">
        Llevamos la cultura de trabajo y la innovación de Nuevo León a cada obra.
        Con <strong>16 años de experiencia comprobada</strong>, somos el socio estratégico
        que los gobiernos estatales, municipales y la iniciativa privada eligen para ejecutar
        proyectos de ingeniería vial de alto impacto con ética y profesionalismo.
      </p>

      <div class="hero-actions">
        <a href="/contacto" class="btn-primary magnetic">
          <span>Solicitar cotización</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="/calderas-termoplasticas-tepate.pdf" download class="btn-ghost magnetic">
          <span>Descargar Catálogo</span>
        </a>
      </div>

      <div class="hero-social" aria-label="Redes sociales" style="display:flex;gap:16px;margin-top:28px;align-items:center;">
        <a href="https://wa.me/528118959042" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" style="color:#fff;display:inline-flex;padding:8px;transition:color .2s;" onmouseover="this.style.color='#E1FF00'" onmouseout="this.style.color='#fff'">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.118 1.522 5.848L0 24l6.335-1.502A11.954 11.954 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.002-1.366l-.36-.213-3.761.892.952-3.653-.234-.374A9.818 9.818 0 1112 21.818z"/></svg>
        </a>
        <a href="https://www.facebook.com/profile.php?id=100063746240114" target="_blank" rel="noopener noreferrer" aria-label="Facebook" style="color:#fff;display:inline-flex;padding:8px;transition:color .2s;" onmouseover="this.style.color='#E1FF00'" onmouseout="this.style.color='#fff'">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href="#" aria-label="TikTok (próximamente)" style="color:#fff;display:inline-flex;padding:8px;transition:color .2s;" onmouseover="this.style.color='#E1FF00'" onmouseout="this.style.color='#fff'">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.79 1.53V6.78a4.85 4.85 0 01-1.02-.09z"/></svg>
        </a>
        <a href="#" aria-label="Instagram (próximamente)" style="color:#fff;display:inline-flex;padding:8px;transition:color .2s;" onmouseover="this.style.color='#E1FF00'" onmouseout="this.style.color='#fff'">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
      </div>

	    </div>

    <div class="hero-right">
      <div class="hero-visual">
        {/* TODO CLIENT: reemplazar con video real de aplicación de termoplástica cuando el cliente lo proporcione */}
        <img
          class="hero-bg-img parallax-img"
          src="/proyectos_nuevos/termoplastica_macro_carretera.webp"
          alt=""
          aria-hidden="true"
          loading="eager"
          decoding="async"
        />
        <div class="hero-visual-overlay"></div>

        <!-- Scroll indicator -->
        <div class="hero-scroll" aria-hidden="true">
          <span class="hero-scroll-l">Scroll</span>
          <div class="hero-scroll-line"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       MARQUEE — Product categories ticker
       ═══════════════════════════════════════════════════════════ -->
  <div class="prod-ticker" aria-hidden="true">
    <div class="prod-ticker-track">
      <span>Calderas Termoplásticas</span><span class="ptick-sep">◆</span>
      <span>Máquinas Aplicadoras</span><span class="ptick-sep">◆</span>
      <span>Dados y Zapatas</span><span class="ptick-sep">◆</span>
      <span>Señalamiento Horizontal</span><span class="ptick-sep">◆</span>
      <span>Señalamiento Vertical</span><span class="ptick-sep">◆</span>
      <span>Dispositivos de Confinamiento</span><span class="ptick-sep">◆</span>
      <span>Equipos con Panel Solar</span><span class="ptick-sep">◆</span>
      <span>Calderas Termoplásticas</span><span class="ptick-sep">◆</span>
      <span>Máquinas Aplicadoras</span><span class="ptick-sep">◆</span>
      <span>Dados y Zapatas</span><span class="ptick-sep">◆</span>
      <span>Señalamiento Horizontal</span><span class="ptick-sep">◆</span>
      <span>Señalamiento Vertical</span><span class="ptick-sep">◆</span>
      <span>Dispositivos de Confinamiento</span><span class="ptick-sep">◆</span>
      <span>Equipos con Panel Solar</span><span class="ptick-sep">◆</span>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       BENTO GRID — Product lines showcase
       Asymmetric, magazine-style product presentation
       ═══════════════════════════════════════════════════════════ -->
  <section class="prod-bento-section" aria-labelledby="prods-bento-heading">
    <div class="prod-bento-header reveal-up">
      <span id="prods-bento-heading" class="prod-bento-eyebrow">Nuestras Líneas</span>
      <a href="/productos" class="prod-bento-all magnetic">Catálogo completo →</a>
    </div>

    <div class="prod-bento-grid reveal-stagger">
      <!-- 01 — CALDERAS (featured, spans 2 rows on desktop) -->
      <a href="/productos?cat=calderas" class="pbc pbc--featured">
        <span class="pbc-num">01</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <rect x="3" y="7" width="18" height="12"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="8" y1="7" x2="8" y2="4"/>
            <line x1="12" y1="7" x2="12" y2="4"/>
            <line x1="16" y1="7" x2="16" y2="4"/>
          </svg>
        </div>
        <p class="pbc-name">Calderas Termoplásticas</p>
        <p class="pbc-desc">100% hidráulicas, diseñadas sobre pedido. Doble cilindraje disponible. Componentes Kohler, Parker y Vickers. Unidades individuales o sobre remolque.</p>
        <span class="pbc-tags">400 kg · 500 kg · 1,000 kg · 2,000 kg</span>
        <span class="pbc-link">Ver modelos →</span>
      </a>

      <!-- 02 — MÁQUINAS APLICADORAS -->
      <a href="/productos?cat=maquinas" class="pbc">
        <span class="pbc-num">02</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <rect x="2" y="8" width="14" height="8"/>
            <rect x="4" y="16" width="4" height="3"/>
            <rect x="11" y="16" width="4" height="3"/>
            <line x1="16" y1="12" x2="21" y2="12"/>
            <line x1="19" y1="9" x2="21" y2="12"/>
          </svg>
        </div>
        <p class="pbc-name">Máquinas Aplicadoras</p>
        <span class="pbc-tags">200 kg · 250 kg · 300 kg</span>
        <span class="pbc-link">Ver →</span>
      </a>

      <!-- 03 — DADOS Y ZAPATAS -->
      <a href="/productos?cat=dados" class="pbc">
        <span class="pbc-num">03</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <line x1="2" y1="12" x2="22" y2="12"/>
            <line x1="5" y1="8" x2="5" y2="16"/>
            <line x1="9" y1="8" x2="9" y2="16"/>
            <line x1="13" y1="8" x2="13" y2="16"/>
            <line x1="17" y1="8" x2="17" y2="16"/>
            <line x1="21" y1="8" x2="21" y2="16"/>
          </svg>
        </div>
        <p class="pbc-name">Dados y Zapatas</p>
        <span class="pbc-tags">10 · 15 · 20 · 30 · 40 · 60 cm</span>
        <span class="pbc-link">Ver →</span>
      </a>

      <!-- 04 — SEÑALAMIENTO HORIZONTAL -->
      <a href="/productos?cat=senalamiento" class="pbc">
        <span class="pbc-num">04</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </div>
        <p class="pbc-name">Señalamiento Horizontal</p>
        <span class="pbc-tags">Termoplástica AASHTO · SCT</span>
        <span class="pbc-link">Ver →</span>
      </a>

      <!-- 05 — SEÑALAMIENTO VERTICAL -->
      <a href="/productos?cat=senalamiento" class="pbc">
        <span class="pbc-num">05</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M12 2l10 10-10 10L2 12z"/>
            <line x1="12" y1="8" x2="12" y2="14"/>
            <line x1="12" y1="16.5" x2="12" y2="17"/>
          </svg>
        </div>
        <p class="pbc-name">Señalamiento Vertical</p>
        <span class="pbc-tags">Bajo · Elevado · SR / SP / SIS</span>
        <span class="pbc-link">Ver →</span>
      </a>

      <!-- 06 — CONFINAMIENTO -->
      <a href="/productos?cat=confinamiento" class="pbc">
        <span class="pbc-num">06</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <rect x="2" y="10" width="20" height="4"/>
            <line x1="6" y1="10" x2="5" y2="6"/>
            <line x1="18" y1="10" x2="19" y2="6"/>
            <line x1="6" y1="14" x2="5" y2="18"/>
            <line x1="18" y1="14" x2="19" y2="18"/>
          </svg>
        </div>
        <p class="pbc-name">Dispositivos de Confinamiento</p>
        <span class="pbc-tags">Confinamiento · Delimitación</span>
        <span class="pbc-link">Ver →</span>
      </a>

      <!-- 07 — EQUIPOS SOLAR -->
      <a href="/productos?cat=solar" class="pbc">
        <span class="pbc-num">07</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <rect x="3" y="3" width="7" height="7"/>
            <rect x="14" y="3" width="7" height="7"/>
            <rect x="3" y="14" width="7" height="7"/>
            <rect x="14" y="14" width="7" height="7"/>
          </svg>
        </div>
        <p class="pbc-name">Equipos con Panel Solar</p>
        <span class="pbc-tags">Destellantes · Vial</span>
        <span class="pbc-link">Ver →</span>
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       QUICK QUOTE — B2B conversion strip
       ═══════════════════════════════════════════════════════════ -->
  <section class="quick-quote" aria-label="Cotización rápida">
    <div class="quick-quote-inner reveal-up">
      <div class="quick-quote-head">
        <span class="sec-tag">Cotización empresarial</span>
        <h2 class="sec-h2">¿Necesitas una <span class="acc">cotización formal?</span></h2>
        <p class="quick-quote-lead">Atendemos licitaciones, obra pública y proyectos privados. Entrega de propuesta técnica y económica en PDF en menos de 24 horas hábiles.</p>
      </div>
      <div class="quick-quote-grid">
        <div class="qq-step">
          <div class="qq-num">01</div>
          <h3 class="qq-title">Cuéntanos tu proyecto</h3>
          <p class="qq-desc">Selecciona el producto o servicio, indica volumen estimado y ubicación. Adjunta bases de licitación si aplica.</p>
        </div>
        <div class="qq-step">
          <div class="qq-num">02</div>
          <h3 class="qq-title">Análisis técnico</h3>
          <p class="qq-desc">Nuestros ingenieros revisan especificaciones, normativa aplicable y logística para entregar una propuesta precisa.</p>
        </div>
        <div class="qq-step">
          <div class="qq-num">03</div>
          <h3 class="qq-title">Propuesta en 24h</h3>
          <p class="qq-desc">Recibes cotización formal en PDF con especificaciones técnicas, tiempos de entrega y condiciones comerciales.</p>
        </div>
      </div>
      <div class="quick-quote-actions">
        <a href="/contacto" class="btn-primary magnetic">Iniciar cotización →</a>
        <a href="https://wa.me/528118959042" target="_blank" rel="noopener noreferrer" class="btn-ghost">Asesoría por WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       TRUST BAND — Stats & credibility
       Full-width numerical impact
       ═══════════════════════════════════════════════════════════ -->
  <section class="trust-band" aria-label="Estadísticas de la empresa">
    <div class="trust-grid">
      <div class="trust-item reveal-up">
        <span class="trust-n" data-value="16">0</span>
        <span class="trust-plus">+</span>
        <span class="trust-l">Años de experiencia</span>
      </div>
      <div class="trust-item reveal-up">
        <span class="trust-n" data-value="500">0</span>
        <span class="trust-plus">+</span>
        <span class="trust-l">Proyectos ejecutados</span>
      </div>
      <div class="trust-item reveal-up">
        <span class="trust-n" data-value="32">0</span>
        <span class="trust-l">Estados de México</span>
      </div>
      <div class="trust-item reveal-up">
        <span class="trust-n">SCT</span>
        <span class="trust-l">Norma N-CMT-5-001-13</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       WHY TEPATE — Editorial split layout
       ═══════════════════════════════════════════════════════════ -->
  <section class="why-editorial" aria-labelledby="why-heading">
    <div class="why-visual reveal-up">
      <div class="why-img-wrap">
        <img src="/TEPATE_Imagenes_Organizadas/03_Informacion_Empresa/fabrica-apodaca.webp" alt="Planta de fabricación TEPATE en Apodaca" loading="lazy" class="parallax-img" />
      </div>
      <div class="why-img-caption">
        <span class="trophy-badge">Planta Apodaca, NL</span>
      </div>
    </div>

    <div class="why-content">
      <div class="reveal-up">
        <span class="sec-tag">Por qué elegirnos</span>
        <h2 id="why-heading" class="sec-h2">
          Ingeniería que<br/><span class="acc">cumple.</span>
        </h2>
      </div>

      <div class="why-list reveal-stagger">
        <div class="why-item">
          <span class="why-num">01</span>
          <div>
            <h3 class="why-title">Fabricación propia</h3>
            <p class="why-desc">Diseñamos y construimos cada equipo en nuestra planta de Apodaca. Control total de calidad, sin intermediarios.</p>
          </div>
        </div>
        <div class="why-item">
          <span class="why-num">02</span>
          <div>
            <h3 class="why-title">Normativa SCT & ASTM</h3>
            <p class="why-desc">Todos nuestros productos cumplen con la Norma N-CMT-5-001-13 de la SCT y estándares ASTM internacionales.</p>
          </div>
        </div>
        <div class="why-item">
          <span class="why-num">03</span>
          <div>
            <h3 class="why-title">Envíos nacionales</h3>
            <p class="why-desc">Entregamos en los 32 estados de México. Logística propia y tiempos de entrega competitivos.</p>
          </div>
        </div>
        <div class="why-item">
          <span class="why-num">04</span>
          <div>
            <h3 class="why-title">Soporte técnico</h3>
            <p class="why-desc">Asesoría en campo, capacitación de operadores y mantenimiento preventivo post-venta.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       CTA BAND — High-contrast conversion zone
       ═══════════════════════════════════════════════════════════ -->
  <section class="cta-band" aria-label="Cotización">
    <div class="cta-inner">
      <div class="reveal-up">
        <h2 class="cta-h2">
          ¿Tienes un proyecto<br/>de señalización?
        </h2>
        <p class="cta-sub">
          Recibe una propuesta técnica y económica en menos de 24 horas hábiles.
          Sin compromiso.
        </p>
      </div>
      <div class="cta-side reveal-up">
        <a href="/contacto" class="btn-dark magnetic">
          <span>Iniciar cotización</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <span class="cta-aside">Respuesta garantizada en 24h</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       CONTACT — Minimal, confident form
       ═══════════════════════════════════════════════════════════ -->
  <section class="contact-section" aria-labelledby="contacto-heading">
    <div class="contact-inner">
      <div class="contact-head reveal-up">
        <span class="sec-tag">Contáctanos</span>
        <h2 id="contacto-heading" class="sec-h2">
          Cuéntanos tu<br/><span class="acc">proyecto.</span>
        </h2>
        <p class="contact-lead">
