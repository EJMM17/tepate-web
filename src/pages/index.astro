---
import Layout from '@/layouts/Layout.astro';
import ContactForm from '@/components/ContactForm.tsx';
import { buildSeo, buildLocalBusinessJsonLd } from '@/lib/seo';
import { COMPANY } from '@/data/navigation';

const seo = buildSeo({
  title: 'INGENIERÍA VIAL TEPATE — Fomentando la Cultura Vial y sus Valores',
  description:
    'Fabricación e instalación de calderas termoplásticas, señalamiento horizontal y vertical, dispositivos de protección y equipos solares. Cumplimiento SCT N-CMT-5-001-13 y ASTM. Envíos en todo México.',
  canonical: `${COMPANY.url}/`,
  jsonLd: buildLocalBusinessJsonLd(),
});
---

<Layout {...seo}>
  <!-- ── HERO ─────────────────────────────────────────── -->
  <div class="hero">
    <div class="hero-left">
      <span class="eyebrow">
        <span class="dot"></span>
        16 años · SCT N-CMT-5-001-13 · ASTM
      </span>
      <h1 class="hero-h1">
        Fomentando la Cultura Vial<br />
        <span class="acc">y sus Valores.</span>
      </h1>
      <p class="hero-sub">
        Fabricación e instalación de <strong>calderas termoplásticas</strong>,
        señalamiento horizontal y vertical, dispositivos de protección y equipos
        solares. Envíos a todo México.
      </p>
      <div class="hero-actions">
        <a href="/contacto" class="btn-primary">Solicitar cotización →</a>
        <a
          href="/calderas-termoplasticas-tepate.pdf"
          download
          class="btn-ghost"
        >Descargar Catálogo</a>
      </div>
    </div>

    <div class="hero-right">
      <div class="hero-visual">
        <img
          class="hero-bg-img"
          src="/hero-bg.gif"
          alt=""
          aria-hidden="true"
          loading="eager"
          decoding="async"
        />
        <div class="hero-visual-overlay"></div>
        <div class="hero-float-stats">
          <div class="hfs-item">
            <span class="hfs-n">16+</span>
            <span class="hfs-l">Años de Exp.</span>
          </div>
          <div class="hfs-divider"></div>
          <div class="hfs-item">
            <span class="hfs-n">SCT</span>
            <span class="hfs-l">Certificación</span>
          </div>
          <div class="hfs-divider"></div>
          <div class="hfs-item">
            <span class="hfs-n">ASTM</span>
            <span class="hfs-l">Estándar</span>
          </div>
        </div>
        <div class="hero-scroll" aria-hidden="true">
          <span class="hero-scroll-l">Scroll</span>
          <div class="hero-scroll-line"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── TICKER MARQUEE ────────────────────────────────── -->
  <div class="prod-ticker" aria-hidden="true">
    <div class="prod-ticker-track">
      <span>Calderas Termoplásticas</span><span class="ptick-sep">◆</span>
      <span>Máquinas Aplicadoras</span><span class="ptick-sep">◆</span>
      <span>Dados y Zapatas</span><span class="ptick-sep">◆</span>
      <span>Señalamiento Horizontal</span><span class="ptick-sep">◆</span>
      <span>Señalamiento Vertical</span><span class="ptick-sep">◆</span>
      <span>Dispositivos de Confinamiento</span><span class="ptick-sep">◆</span>
      <span>Equipos con Panel Solar</span><span class="ptick-sep">◆</span>
      <span>Calderas Termoplásticas</span><span class="ptick-sep">◆</span>
      <span>Máquinas Aplicadoras</span><span class="ptick-sep">◆</span>
      <span>Dados y Zapatas</span><span class="ptick-sep">◆</span>
      <span>Señalamiento Horizontal</span><span class="ptick-sep">◆</span>
      <span>Señalamiento Vertical</span><span class="ptick-sep">◆</span>
      <span>Dispositivos de Confinamiento</span><span class="ptick-sep">◆</span>
      <span>Equipos con Panel Solar</span><span class="ptick-sep">◆</span>
    </div>
  </div>

  <!-- ── BENTO PRODUCTOS ────────────────────────────────── -->
  <section class="prod-bento-section" aria-labelledby="prods-bento-heading">
    <div class="prod-bento-header">
      <span id="prods-bento-heading" class="prod-bento-eyebrow">Nuestras Líneas</span>
      <a href="/productos" class="prod-bento-all">Catálogo completo →</a>
    </div>

    <div class="prod-bento-grid">

      <!-- 01 — CALDERAS (featured) -->
      <a href="/productos?cat=calderas" class="pbc pbc--featured">
        <span class="pbc-num">01</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <rect x="3" y="7" width="18" height="12"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="8" y1="7" x2="8" y2="4"/>
            <line x1="12" y1="7" x2="12" y2="4"/>
            <line x1="16" y1="7" x2="16" y2="4"/>
          </svg>
        </div>
        <p class="pbc-name">Calderas Termoplásticas</p>
        <p class="pbc-desc">100% hidráulicas, diseñadas sobre pedido. Doble cilindraje disponible. Componentes Kohler, Parker y Vickers. Unidades individuales o sobre remolque.</p>
        <span class="pbc-tags">400 kg &nbsp;·&nbsp; 500 kg &nbsp;·&nbsp; 1,000 kg &nbsp;·&nbsp; 2,000 kg</span>
        <span class="pbc-link">Ver modelos →</span>
      </a>

      <!-- 02 — MÁQUINAS APLICADORAS -->
      <a href="/productos?cat=maquinas" class="pbc">
        <span class="pbc-num">02</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <rect x="2" y="8" width="14" height="8"/>
            <rect x="4" y="16" width="4" height="3"/>
            <rect x="11" y="16" width="4" height="3"/>
            <line x1="16" y1="12" x2="21" y2="12"/>
            <line x1="19" y1="9" x2="21" y2="12"/>
          </svg>
        </div>
        <p class="pbc-name">Máquinas Aplicadoras</p>
        <span class="pbc-tags">200 kg &nbsp;·&nbsp; 250 kg &nbsp;·&nbsp; 300 kg</span>
        <span class="pbc-link">Ver →</span>
      </a>

      <!-- 04 — SEÑALAMIENTO HORIZONTAL -->
      <a href="/productos?cat=senalamiento" class="pbc">
        <span class="pbc-num">04</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </div>
        <p class="pbc-name">Señalamiento Horizontal</p>
        <span class="pbc-tags">Termoplástica AASHTO &nbsp;·&nbsp; SCT</span>
        <span class="pbc-link">Ver →</span>
      </a>

      <!-- 06 — CONFINAMIENTO -->
      <a href="/productos?cat=confinamiento" class="pbc">
        <span class="pbc-num">06</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <rect x="2" y="10" width="20" height="4"/>
            <line x1="6" y1="10" x2="5" y2="6"/>
            <line x1="18" y1="10" x2="19" y2="6"/>
            <line x1="6" y1="14" x2="5" y2="18"/>
            <line x1="18" y1="14" x2="19" y2="18"/>
          </svg>
        </div>
        <p class="pbc-name">Dispositivos de Confinamiento</p>
        <span class="pbc-tags">Confinamiento &nbsp;·&nbsp; Delimitación</span>
        <span class="pbc-link">Ver →</span>
      </a>

      <!-- 03 — DADOS Y ZAPATAS -->
      <a href="/productos?cat=dados" class="pbc">
        <span class="pbc-num">03</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <line x1="2" y1="12" x2="22" y2="12"/>
            <line x1="5" y1="8" x2="5" y2="16"/>
            <line x1="9" y1="8" x2="9" y2="16"/>
            <line x1="13" y1="8" x2="13" y2="16"/>
            <line x1="17" y1="8" x2="17" y2="16"/>
            <line x1="21" y1="8" x2="21" y2="16"/>
          </svg>
        </div>
        <p class="pbc-name">Dados y Zapatas</p>
        <span class="pbc-tags">10 · 15 · 20 · 30 · 40 · 60 cm</span>
        <span class="pbc-link">Ver →</span>
      </a>

      <!-- 05 — SEÑALAMIENTO VERTICAL -->
      <a href="/productos?cat=senalamiento" class="pbc">
        <span class="pbc-num">05</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M12 2l10 10-10 10L2 12z"/>
            <line x1="12" y1="8" x2="12" y2="14"/>
            <line x1="12" y1="16.5" x2="12" y2="17"/>
          </svg>
        </div>
        <p class="pbc-name">Señalamiento Vertical</p>
        <span class="pbc-tags">Bajo &nbsp;·&nbsp; Elevado &nbsp;·&nbsp; SR / SP / SIS</span>
        <span class="pbc-link">Ver →</span>
      </a>

      <!-- 07 — EQUIPOS SOLAR -->
      <a href="/productos?cat=solar" class="pbc">
        <span class="pbc-num">07</span>
        <div class="pbc-ico">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <rect x="3" y="3" width="7" height="7"/>
            <rect x="14" y="3" width="7" height="7"/>
            <rect x="3" y="14" width="7" height="7"/>
            <rect x="14" y="14" width="7" height="7"/>
          </svg>
        </div>
        <p class="pbc-name">Equipos con Panel Solar</p>
        <span class="pbc-tags">Destellantes &nbsp;·&nbsp; Vial</span>
        <span class="pbc-link">Ver →</span>
      </a>

    </div>
  </section>

  <!-- ── CONTACTO ─────────────────────────────────────── -->
  <section class="px-4 md:px-8 py-12 md:py-20 lg:py-24" aria-labelledby="contacto-heading">
    <div class="max-w-screen-md mx-auto">
      <p class="font-mono text-xs uppercase tracking-widest text-neon mb-3">Contáctanos</p>
      <h2 id="contacto-heading" class="font-display font-bold text-white text-display-md uppercase mb-3">
        Cuéntanos tu proyecto
      </h2>
      <p class="text-bone mb-8 md:mb-10">
        Respondemos en menos de 24 horas hábiles. Sin spam, sin compromiso.
      </p>
      <ContactForm client:visible />
    </div>
  </section>
</Layout>
