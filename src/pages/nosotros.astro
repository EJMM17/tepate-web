---
import Layout from '@/layouts/Layout.astro';
import { buildSeo, buildBreadcrumbJsonLd } from '@/lib/seo';
import { COMPANY } from '@/data/navigation';

const seo = buildSeo({
  title: 'Nosotros — Ingeniería Vial TEPATE',
  description:
    'Ingeniería Vial TEPATE — 16 años fabricando equipos termoplásticos y señalamiento vial. Misión, visión, clientes y proveedores. Cumplimiento SCT y ASTM.',
  canonical: `${COMPANY.url}/nosotros`,
  ogImage:
    'https://tepate.com.mx/TEPATE_Imagenes_Organizadas/03_Informacion_Empresa/slide03_Informacion_General_Empresa_img1.webp',
  jsonLd: [
    {
      '@context': 'https://schema.org',
      '@type': 'AboutPage',
      name: 'Nosotros — Ingeniería Vial TEPATE',
      url: `${COMPANY.url}/nosotros`,
      description:
        'Conoce la historia, misión y valores de Ingeniería Vial TEPATE, empresa mexicana especializada en señalamiento y seguridad vial.',
      about: {
        '@type': 'Organization',
        name: COMPANY.legalName,
        url: COMPANY.url,
        logo: `${COMPANY.url}/logo.webp`,
        foundingDate: '2010',
        foundingLocation: { '@type': 'Place', addressLocality: 'Apodaca', addressRegion: 'Nuevo León', addressCountry: 'MX' },
        areaServed: { '@type': 'Country', name: 'México' },
        knowsAbout: ['Señalamiento Vial', 'Termoplástico Vial', 'Seguridad Vial', 'SCT N-CMT-5-001-13'],
      },
    },
    buildBreadcrumbJsonLd([
      { name: 'Inicio', url: COMPANY.url },
      { name: 'Nosotros', url: `${COMPANY.url}/nosotros` },
    ]),
  ],
});

const clients = [
  { name: 'Mercedes-Benz',    logo: '/TEPATE_Marcas/Principales_Clientes/Mercedes_Benz.png' },
  { name: 'OMA Aeropuertos',  logo: '/TEPATE_Marcas/Principales_Clientes/OMA_Aeropuertos.png' },
  { name: 'ICA',              logo: '/TEPATE_Marcas/Principales_Clientes/ICA_transparent.png' },
  { name: 'Stiva',            logo: '/TEPATE_Marcas/Principales_Clientes/Stiva_transparent.png' },
  { name: 'Vitro',            logo: '/TEPATE_Marcas/Principales_Clientes/Vitro_transparent.png' },
  { name: 'FRISA',            logo: '/TEPATE_Marcas/Principales_Clientes/FRISA_transparent.png' },
  { name: 'Solvay',           logo: '/TEPATE_Marcas/Principales_Clientes/Solvay.png' },
  { name: 'Grupo Calidra',    logo: '/TEPATE_Marcas/Principales_Clientes/Grupo_Calidra_transparent.png' },
  { name: 'GP Construcción',  logo: '/TEPATE_Marcas/Principales_Clientes/GP_Construccion_transparent.png' },
  { name: 'IDEI',             logo: '/TEPATE_Marcas/Principales_Clientes/IDEI_Construyendo_Mexico.webp' },
  { name: 'Daewoo',           logo: '/TEPATE_Marcas/Principales_Clientes/Daewoo_transparent.png' },
  { name: 'Nutrioli',         logo: '/TEPATE_Marcas/Principales_Clientes/Nutrioli_transparent.png' },
  { name: 'Gruma',            logo: '/TEPATE_Marcas/Principales_Clientes/Gruma.png' },
  { name: 'Comex',            logo: '/TEPATE_Marcas/Materiales_Termoplasticos/Comex_Termoplastico.webp' },
];

const suppliers = [
  { name: '3M',               logo: '/TEPATE_Marcas/Laminas_Senalamiento/3M.webp' },
  { name: 'Avery Dennison',   logo: '/TEPATE_Marcas/Laminas_Senalamiento/Avery_Dennison_transparent.png' },
  { name: 'Ennis-Flint',      logo: '/TEPATE_Marcas/Laminas_Senalamiento/Ennis_Flint_transparent.png' },
  { name: 'Sherwin Williams', logo: '/TEPATE_Marcas/Laminas_Senalamiento/Sherwin_Williams.png' },
  { name: 'Swarco',           logo: '/TEPATE_Marcas/Materiales_Termoplasticos/SWARCO_Road_Marking_transparent.png' },
  { name: 'Crown Technology', logo: '/TEPATE_Marcas/Materiales_Termoplasticos/Crown_Technology_transparent.png' },
  { name: 'Dynakrom',         logo: '/TEPATE_Marcas/Materiales_Termoplasticos/Dynakrom_transparent.png' },
  { name: 'Comex',            logo: '/TEPATE_Marcas/Materiales_Termoplasticos/Comex_Termoplastico.webp' },
  { name: 'Kohler',           logo: '/TEPATE_Marcas/Componentes_Calderas/Kohler_motores_transparent.png' },
  { name: 'Continental',      logo: '/TEPATE_Marcas/Componentes_Calderas/Continental_transparent.png' },
  { name: 'Parker Hannifin',  logo: '/TEPATE_Marcas/Componentes_Calderas/Parker_Hannifin_transparent.png' },
  { name: 'Vickers',          logo: '/TEPATE_Marcas/Componentes_Calderas/Vickers_hidraulica_transparent.png' },
];
---

<Layout {...seo}>
  <section class="page-header">
    <div class="ph-inner reveal-up">
      <div class="ph-crumb"><a href="/">Inicio</a><span>/</span>Nosotros</div>
      <h1 class="ph-title">NUESTRA <span class="acc">TRAYECTORIA</span> Y VALORES</h1>
      <p class="ph-lead">
        INGENIERÍA VIAL TEPATE, S.A. de C.V. es una empresa dedicada a diseñar y proyectar
        soluciones en ingeniería civil, arquitectura, ingeniería vial, estudios viales de
        semaforización, aeropuertos, ciclovías y fabricación de equipos termoplásticos.
        Desarrollamos cada proyecto con ética y profesionalismo.
      </p>
    </div>
  </section>

  <!-- MISIÓN, VISIÓN, OBJETIVO, POLÍTICA -->
  <section class="pcat reveal-up">
    <div class="pcat-head">
      <div>
        <div class="pcat-num">Quiénes somos</div>
        <h2 class="pcat-h2">MISIÓN, VISIÓN<br />Y VALORES</h2>
      </div>
      <p class="pcat-desc">
        Nuestros pilares son la base de cada proyecto que entregamos. Nos regimos por un
        compromiso diario con la calidad, la honestidad y la mejora continua.
      </p>
    </div>
    <div class="mvv">
      <div class="mvv-card">
        <div class="mvv-ico">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1" fill="#39FF14"/></svg>
        </div>
        <div class="mvv-h">Misión</div>
        <p class="mvv-p">
          Dar soluciones de seguridad y movilidad urbana para automovilistas y peatones a través
          de dispositivos y productos de calidad en calles, carreteras y autopistas, con el
          objetivo de un mejor desplazamiento mediante tecnología eficaz.
        </p>
      </div>
      <div class="mvv-card">
        <div class="mvv-ico">
          <svg viewBox="0 0 24 24"><path d="M12 3L2 12h3v8h6v-6h2v6h6v-8h3z"/></svg>
        </div>
        <div class="mvv-h">Visión</div>
        <p class="mvv-p">
          Ser una empresa líder en fabricación de productos de vialidad, brindando soluciones a
          nuestros clientes con dispositivos, máquinas y equipos innovadores de alta calidad, con
          presencia nacional e internacional.
        </p>
      </div>
      <div class="mvv-card">
        <div class="mvv-ico">
          <svg viewBox="0 0 24 24"><path d="M4 4h16v16H4z"/><path d="M9 12l2 2 4-4"/></svg>
        </div>
        <div class="mvv-h">Objetivo</div>
        <p class="mvv-p">
          Nuestro compromiso diario es mantener calidad en los productos, honestidad, ética y
          trabajo en equipo con nuestros clientes, buscando el crecimiento constante de la empresa
          y de cada proyecto entregado.
        </p>
      </div>
      <div class="mvv-card">
        <div class="mvv-ico">
          <svg viewBox="0 0 24 24"><path d="M12 2v20M2 12h20"/><circle cx="12" cy="12" r="9"/></svg>
        </div>
        <div class="mvv-h">Política de Calidad</div>
        <p class="mvv-p">
          Brindar a nuestros clientes productos y servicios profesionales con calidad humana, a
          través de la mejora continua de nuestros procesos, teniendo como prioridad la
          capacitación constante de nuestro personal.
        </p>
      </div>
    </div>
  </section>

  <!-- CERTIFICACIONES -->
  <section class="pcat reveal-up">
    <div class="pcat-head">
      <div>
        <div class="pcat-num">Certificaciones</div>
        <h2 class="pcat-h2">CUMPLIMIENTO<br />NORMATIVO</h2>
      </div>
      <p class="pcat-desc">
        Todos nuestros productos y procesos cumplen con las normas oficiales mexicanas y estándares
        internacionales aplicables a vialidad, señalamiento y seguridad.
      </p>
    </div>
    <div class="duo">
      <div class="duo-panel">
        <div class="duo-label">Normativa aplicable</div>
        <div class="duo-title">Normas y estándares</div>
        <div class="duo-body">
          <ul>
            <li><strong>SCT N-CMT-5-001-13</strong> · Calidad de materiales para señalamiento horizontal</li>
            <li><strong>Norma ASTM</strong> · Especificaciones de materiales y reflectividad</li>
            <li><strong>AASHTO</strong> · American Association of State Highway Officials</li>
            <li><strong>TxDOT</strong> · Texas Department of Transportation</li>
            <li><strong>HCM 7th Edition</strong> · Highway Capacity Manual</li>
          </ul>
        </div>
      </div>
      <div class="duo-panel">
        <div class="duo-label">Alcance</div>
        <div class="duo-title">Tipo de clientes</div>
        <div class="duo-body">
          <p>
            Nuestra experiencia abarca los tres sectores del mercado vial mexicano, con atención
            especializada para procesos de licitación pública y contratación privada.
          </p>
          <ul>
            <li>Dependencias estatales</li>
            <li>Gobiernos municipales</li>
            <li>Iniciativa privada</li>
            <li>Constructoras y desarrolladoras</li>
            <li>Facturación CFDI y atención a licitaciones</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- PRINCIPALES CLIENTES -->
  <section class="pcat reveal-up">
    <div class="pcat-head">
      <div>
        <div class="pcat-num">Confianza</div>
        <h2 class="pcat-h2">PRINCIPALES<br />CLIENTES</h2>
      </div>
      <p class="pcat-desc">
        A lo largo de nuestra historia hemos trabajado con empresas líderes de la industria,
        parques industriales, desarrolladores, municipios del área metropolitana de Monterrey y
        dependencias federales.
      </p>
    </div>
    <div class="clients">
      {clients.map(({ name, logo }) => (
        <div class="client">
          <img src={logo} alt={name} title={name} class="brand-logo-grid" loading="lazy" />
        </div>
      ))}
    </div>
  </section>

  <!-- PROVEEDORES -->
  <section class="pcat reveal-up">
    <div class="pcat-head">
      <div>
        <div class="pcat-num">Alianzas</div>
        <h2 class="pcat-h2">NUESTROS<br />PROVEEDORES</h2>
      </div>
      <p class="pcat-desc">
        Trabajamos exclusivamente con marcas líderes mundiales en pinturas viales, películas
        reflectivas, termoplásticos y componentes hidráulicos. Esto garantiza calidad consistente
        y disponibilidad de refacciones.
      </p>
    </div>
    <div class="clients">
      {suppliers.map(({ name, logo }) => (
        <div class="client">
          <img src={logo} alt={name} title={name} class="brand-logo-grid" loading="lazy" />
        </div>
      ))}
    </div>
  </section>

  <!-- UBICACIÓN -->
  <section class="pcat reveal-up">
    <div class="pcat-head">
      <div>
        <div class="pcat-num">Ubicación</div>
        <h2 class="pcat-h2">NUESTRA<br />PLANTA</h2>
      </div>
      <p class="pcat-desc">
        Ubicados estratégicamente en el corazón industrial de Nuevo León, en Apodaca. Desde aquí
        coordinamos la fabricación y logística para todo el territorio nacional.
      </p>
    </div>
    <div style="border:1px solid var(--steel);overflow:hidden;aspect-ratio:16/6;min-height:260px;">
      <iframe
        title="Ubicación TEPATE — Calle La Fragua #193, Col. Chulavista, Guadalupe, N.L."
        src="https://www.openstreetmap.org/export/embed.html?bbox=-100.2800%2C25.6600%2C-100.2400%2C25.7000&layer=mapnik&marker=25.6739%2C-100.2637"
        width="100%"
        height="100%"
        style="border:0;display:block"
        loading="lazy"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
    <p style="font-size:12px;color:var(--mist);margin-top:8px;font-family:var(--fm)">
      Calle La Fragua #193 / Río La Silla, Col. Chulavista, Guadalupe, N.L. ·
      <a
        href="https://maps.google.com/maps?q=Calle+La+Fragua+193+Col.+Chulavista+Guadalupe+Nuevo+Leon+Mexico"
        target="_blank"
        rel="noopener noreferrer"
        style="color:var(--neon);text-decoration:none"
      >Abrir en Google Maps ↗</a>
    </p>
    <p style="font-size:11px;color:var(--mist);margin-top:4px;font-family:var(--fm)">
      Atención previa cita para revisión de equipos y proyectos.
    </p>
  </section>

  <!-- PRESENTACIÓN INSTITUCIONAL -->
  <section class="pcat reveal-up" style="padding-top:48px;padding-bottom:48px;">
    <div class="pcat-head" style="margin-bottom:24px;">
      <div>
        <div class="pcat-num">Recursos Corporativos</div>
        <h2 class="pcat-h2">PRESENTACIÓN<br />INSTITUCIONAL</h2>
      </div>
      <p class="pcat-desc">
        Descarga nuestra presentación corporativa 2024 con información completa sobre nuestra
        empresa, servicios, equipos y principales proyectos realizados en México.
      </p>
    </div>
    <a
      href="/presentacion-tepate-2024.pdf"
      download
      class="inline-flex items-center gap-2.5 bg-neon text-black font-mono text-xs font-bold uppercase tracking-widest px-6 py-3.5 no-underline"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
        <polyline points="7 10 12 15 17 10"/>
        <line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      Descargar Presentación 2024 (PDF)
    </a>
  </section>

  <!-- CTA -->
  <section class="cta-band" style="padding:0">
    <div class="cta-inner">
      <div>
        <h2 class="cta-h2">Construyendo caminos<br />más seguros</h2>
        <p class="cta-sub">
          Nuestra experiencia respalda cada proyecto que entregamos. Únete a los más de 500
          clientes que ya confían en TEPATE.
        </p>
      </div>
      <div class="cta-side">
        <a href="/contacto" class="btn-dark">Contactar Ahora</a>
        <span class="cta-aside">Atención especializada</span>
      </div>
    </div>
  </section>
</Layout>

