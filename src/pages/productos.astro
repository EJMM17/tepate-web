---
import Layout from '@/layouts/Layout.astro';
import { buildSeo, buildBreadcrumbJsonLd, buildFaqJsonLd } from '@/lib/seo';
import { COMPANY } from '@/data/navigation';
import { PRODUCTS, PRODUCT_CATEGORIES } from '@/data/products';
import ProductModal from '@/components/ProductModal';

const productFaqs = [
  {
    question: '¿Fabrican equipos sobre pedido?',
    answer:
      'Sí. TEPATE fabrica calderas, máquinas aplicadoras y componentes según capacidad, sistema de movilidad y requerimientos de operación del cliente.',
  },
  {
    question: '¿Entregan en todo México?',
    answer:
      'Sí. Coordinamos fabricación, logística y entrega para proyectos públicos y privados en los 32 estados de México.',
  },
  {
    question: '¿Los productos cumplen normativa vial?',
    answer:
      'Trabajamos con especificaciones SCT, ASTM, AASHTO y TxDOT según el tipo de producto, material reflectivo y alcance del proyecto.',
  },
  {
    question: '¿Pueden cotizar para licitaciones?',
    answer:
      'Sí. Atendemos bases de licitación, fichas técnicas, volúmenes, ubicación de obra y tiempos de entrega para propuestas formales.',
  },
] as const;

const productAnchor = (productId: string, category: string): string => {
  if (category !== 'senalamiento') return category;
  return productId.startsWith('sv-') ? 'vertical' : 'horizontal';
};

const seo = buildSeo({
  title: 'Productos — Ingeniería Vial TEPATE',
  description:
    'Catálogo completo de calderas termoplásticas, máquinas aplicadoras, señalamiento horizontal y vertical, dispositivos de protección y equipos solares. Cumplimiento SCT y ASTM.',
  canonical: `${COMPANY.url}/productos`,
  ogImage:
    'https://tepate.com.mx/TEPATE_Imagenes_Organizadas/12_Pintura_Trafico/slide15_Pintura_Trafico_Base_Agua_img1.webp',
  jsonLd: [
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: 'Productos de Señalamiento Vial TEPATE',
      description:
        'Catálogo de calderas termoplásticas, máquinas aplicadoras, dados, zapatas y equipos de confinamiento vial.',
      url: `${COMPANY.url}/productos`,
      numberOfItems: 6,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Calderas Termoplásticas', url: `${COMPANY.url}/productos#calderas` },
        { '@type': 'ListItem', position: 2, name: 'Máquinas Aplicadoras', url: `${COMPANY.url}/productos#maquinas` },
        { '@type': 'ListItem', position: 3, name: 'Señalamiento Horizontal', url: `${COMPANY.url}/productos#horizontal` },
        { '@type': 'ListItem', position: 4, name: 'Señalamiento Vertical', url: `${COMPANY.url}/productos#vertical` },
        { '@type': 'ListItem', position: 5, name: 'Dispositivos de Confinamiento', url: `${COMPANY.url}/productos#confinamiento` },
        { '@type': 'ListItem', position: 6, name: 'Equipos Solares Viales', url: `${COMPANY.url}/productos#solar` },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: 'Catálogo comercial TEPATE',
      itemListElement: PRODUCTS.map((product, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        item: {
          '@type': 'Product',
          name: product.name,
          model: product.model,
          image: `${COMPANY.url}${product.image}`,
          description: product.description ?? product.specs.map((spec) => `${spec.label}: ${spec.value}`).join('. '),
          brand: { '@type': 'Brand', name: 'TEPATE' },
          manufacturer: { '@type': 'Organization', name: COMPANY.legalName },
          url: `${COMPANY.url}/productos#${productAnchor(product.id, product.category)}`,
        },
      })),
    },
    buildFaqJsonLd(productFaqs),
    buildBreadcrumbJsonLd([
      { name: 'Inicio', url: COMPANY.url },
      { name: 'Productos', url: `${COMPANY.url}/productos` },
    ]),
  ],
});

---

<Layout {...seo}>
  <section class="page-header">
    <div class="ph-inner reveal-up">
      <div class="ph-crumb"><a href="/">Inicio</a><span>/</span>Productos</div>
      <h1 class="ph-title">CATÁLOGO <span class="acc">COMPLETO</span></h1>
      <p class="ph-lead">
        Fabricación directa de equipos termoplásticos, señalamiento vial horizontal y vertical,
        dispositivos de protección y equipos solares. Todos nuestros productos cumplen con la norma
        SCT N-CMT-5-001-13 y especificaciones ASTM.
      </p>
    </div>
  </section>

  {PRODUCT_CATEGORIES.map((cat) => {
    const catProducts = PRODUCTS.filter((p) =>
      cat.id === 'horizontal' || cat.id === 'vertical'
        ? p.category === 'senalamiento' && (
            cat.id === 'horizontal'
              ? ['sh-urbana','sh-city-county','sh-sct-mx','sh-aashto','sh-txdot','sh-aashto-city'].includes(p.id)
              : ['sv-sr','sv-sp','sv-sis','sv-sid13','sv-sid15','sv-colonial'].includes(p.id)
          )
        : p.category === cat.id
    );
    const [headLine1, headLine2] = cat.heading.split('\n');
    return (
      <section class="pcat reveal-up" id={cat.id}>
        <div class="pcat-head">
          <div>
            <div class="pcat-num">{cat.num} · {cat.label}</div>
            <h2 class="pcat-h2">{headLine1}<br />{headLine2}</h2>
          </div>
          <p class="pcat-desc">{cat.desc}</p>
        </div>
        <div class="spec-grid">
          {catProducts.map((product) => (
            <div class="spec product-trigger" data-product-id={product.id} data-img={product.image}>
              <div class="spec-photo">
                <img src={product.image} alt={product.imageAlt} loading="lazy" decoding="async" width="600" height="450" />
              </div>
              <div class="spec-info">
                <div class="spec-model">{product.model}</div>
                <div class="spec-name">{product.name}</div>
                <div class="spec-rule"></div>
                <ul class="spec-list">
                  {product.specs.map((spec) => (
                    <li>{spec.label}: {spec.value}</li>
                  ))}
                </ul>
                <div class="spec-cta">
                  <a href={`/contacto?producto=${encodeURIComponent(product.name)}&interes=${productAnchor(product.id, product.category)}`}>Cotizar →</a>
                  <a href={`https://wa.me/528118959042?text=${encodeURIComponent(`Hola, solicito información sobre ${product.name}`)}`} target="_blank" rel="noopener noreferrer">WhatsApp</a>
                </div>
              </div>
            </div>
          ))}
        </div>
        {cat.id === 'calderas' && (
          <div style="margin-top:40px;display:flex;flex-wrap:wrap;gap:12px;">
            <a
              href="/contacto?interes=calderas&servicio=Ficha%20t%C3%A9cnica%20IVT302710-04"
              class="inline-flex items-center gap-2 bg-neon text-black font-mono text-xs font-bold uppercase tracking-widest px-4 py-2.5 no-underline"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Solicitar Ficha Técnica IVT302710-04
            </a>
            <a
              href="/contacto?interes=calderas&servicio=Cat%C3%A1logo%20de%20calderas%20termopl%C3%A1sticas"
              class="inline-flex items-center gap-2 border border-neon text-neon font-mono text-xs font-bold uppercase tracking-widest px-4 py-2.5 no-underline"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Solicitar Catálogo Calderas Termoplásticas
            </a>
          </div>
        )}
      </section>
    );
  })}

  <section class="cta-band" style="padding:0">
    <div class="cta-inner">
      <div>
        <h2 class="cta-h2">¿No encuentras<br />lo que buscas?</h2>
        <p class="cta-sub">
          Fabricamos sobre pedido según las especificaciones de tu proyecto. Envíanos los detalles
          y recibe cotización en menos de 24 horas.
        </p>
      </div>
      <div class="cta-side">
        <a href="/contacto" class="btn-dark">Solicitar Cotización</a>
        <span class="cta-aside">Atención a licitaciones y obra privada</span>
      </div>
    </div>
  </section>

  <section class="pcat" id="faq-productos">
    <div class="pcat-head reveal-up">
      <div>
        <div class="pcat-num">Preguntas frecuentes</div>
        <h2 class="pcat-h2">COTIZACIÓN<br />Y ENTREGA</h2>
      </div>
      <p class="pcat-desc">
        Respuestas rápidas para compras, obra pública, licitaciones y proyectos privados que
        requieren especificación técnica antes de cotizar.
      </p>
    </div>
    <div class="duo reveal-stagger">
      {productFaqs.map((faq) => (
        <div class="duo-panel">
          <div class="duo-label">FAQ</div>
          <div class="duo-title">{faq.question}</div>
          <div class="duo-body">
            <p>{faq.answer}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <ProductModal products={PRODUCTS} client:idle />

  <!-- Sticky CTA Bar -->
  <div class="sticky-cta" id="sticky-cta">
    <div class="sticky-cta-text">
      <strong>¿Necesitas una cotización formal?</strong>
      Respuesta en 24h · Atención a licitaciones
    </div>
    <div class="sticky-cta-actions">
      <a href="/contacto" class="sticky-cta-btn">Cotizar ahora</a>
      <a href="https://wa.me/528118959042" target="_blank" rel="noopener noreferrer" class="sticky-cta-btn-ghost">WhatsApp</a>
    </div>
  </div>

  <script>
    (function() {
      const legacyCategoryMap: Record<string, string> = {
        calderas: 'calderas',
        maquinas: 'maquinas',
        senalamiento: 'horizontal',
        horizontal: 'horizontal',
        vertical: 'vertical',
        confinamiento: 'confinamiento',
        solar: 'solar',
      };

      function getTargetId() {
        const hash = window.location.hash.replace('#', '');
        if (hash) return hash;
        const legacyCat = new URLSearchParams(window.location.search).get('cat') || '';
        return legacyCategoryMap[legacyCat] || '';
      }

      function scrollToCategory() {
        const targetId = getTargetId();
        if (!targetId) return;
        const target = document.getElementById(targetId);
        if (!target) return;
        window.requestAnimationFrame(() => {
          window.setTimeout(() => target.scrollIntoView({ block: 'start' }), 80);
        });
      }

      window.addEventListener('load', scrollToCategory, { once: true });
      window.addEventListener('hashchange', scrollToCategory);
      scrollToCategory();
    })();

    (function() {
      const bar = document.getElementById('sticky-cta');
      if (!bar) return;
      let shown = false;
      function onScroll() {
        const y = window.scrollY || window.pageYOffset;
        const threshold = 400;
        if (y > threshold && !shown) {
          bar?.classList.add('visible');
          shown = true;
        } else if (y <= threshold && shown) {
          bar?.classList.remove('visible');
          shown = false;
        }
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();
  </script>
</Layout>
